			<Item class="ModuleScript" referent="RBX00000003">
				<Properties>
					<string name="Name">Config</string>
					<ProtectedString name="Source"><![CDATA[-- All gameplay tuning lives here so balancing never requires touching logic.
local Config = {}

Config.GameName = "LAUNCH PARTY"

Config.Match = {
	MinFighters = 4, -- bots fill empty slots up to this many fighters
	MaxBots = 5,
	MinRealPlayers = 1,
	RoundsPerMatch = 5,
	FirstIntermission = 12,
	CountdownTime = 3,
	RoundTime = 90,
	SuddenDeathAt = 45, -- seconds into a round before the edges start crumbling
	CrumbleInterval = 2.2,
	FastCrumbleInterval = 0.7, -- used once no real player is still alive
	RoundEndTime = 4,
	DraftTime = 14,
	MatchEndTime = 11,
	PlacementPoints = { 3, 2, 1 },
	KOPoints = 1,
	BountyBonus = 1,
	KOCreditWindow = 6, -- seconds a hit still counts for KO credit
}

Config.Arena = {
	Center = Vector3.new(0, 100, 0),
	Radius = 46,
	TileSize = 7,
	VoidDepth = 35, -- fall this far below the arena surface and you're out
	MinTiles = 5,
}

Config.Lobby = {
	Center = Vector3.new(0, 140, 110),
	Size = Vector3.new(80, 2, 44),
	HeatCap = 40, -- lobby sparring can't build heat past this
	VoidDepth = 30,
}

Config.Combat = {
	PunchCooldown = 0.38,
	PunchRange = 6,
	RangeLeniency = 1.75, -- forgiveness for network latency
	PunchCone = 0.2, -- minimum dot product between aim and target direction
	JabHeat = 7,
	JabKnock = 30,
	ChargeMaxTime = 1.1,
	ChargeThreshold = 0.28, -- fraction of a full charge that counts as a charged punch
	ChargeHeatMult = 2.6,
	ChargeKnockMult = 2.3,
	ChargeRangeBonus = 2,
	ChargeWalkMult = 0.5,
	ShockwaveRadius = 12,
	ShockwavePower = 0.6,
	DashCooldown = 2.0,
	DashSpeed = 80,
	DashDuration = 0.18,
	AirDashLift = 14,
	DashBumpRadius = 4.5,
	DashBumpHeat = 5,
	DashBumpKnock = 26,
	HitstunDashLock = 0.15, -- can't dash-cancel a hit instantly
	-- knockback curve (see Shared/Knockback)
	HeatScale = 0.025,
	VerticalRatio = 0.42,
	VerticalBase = 10,
	MaxKnockSpeed = 230,
	TumbleBase = 0.3,
	TumblePerSpeed = 1 / 220,
	TumbleMax = 1.4,
	MaxActionsPerSecond = 16, -- remote spam protection
}

Config.Events = {
	LowGravity = 80,
	DefaultGravity = 196.2,
	MeteorInterval = { 0.9, 1.6 },
	MeteorRadius = 10,
	MeteorHeat = 14,
	MeteorKnock = 46,
	SweeperSpeed = { 0.9, 2.3 }, -- radians/sec, ramps up over the round
	SweeperHeat = 10,
	SweeperKnock = 42,
	GustInterval = 8,
	GustWarning = 1.6,
	GustKnock = 40,
}

Config.Anims = {
	-- Roblox-owned default R15 animations; usable in any experience.
	Punch = "rbxassetid://522635514",
	Charged = "rbxassetid://522638767",
	Idle = "rbxassetid://507766388",
	Walk = "rbxassetid://507777826",
}

Config.Sounds = {
	-- Built-in engine sounds. Swap for your own uploaded audio any time.
	Swing = "rbxasset://sounds/swordslash.wav",
	ChargedSwing = "rbxasset://sounds/swordlunge.wav",
	Hit = "rbxasset://sounds/collide.wav",
	KO = "rbxasset://sounds/Launching rocket.wav",
	Dash = "rbxasset://sounds/action_jump.mp3",
	Pick = "rbxasset://sounds/electronicpingshort.wav",
	Boom = "rbxasset://sounds/collide.wav",
}

return Config
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000004">
				<Properties>
					<string name="Name">Cosmetics</string>
					<ProtectedString name="Source"><![CDATA[-- Visual identity helpers used by both server (tags, trails) and client (HUD).
local Cosmetics = {}

Cosmetics.RarityColors = {
	Common = Color3.fromRGB(185, 196, 214),
	Rare = Color3.fromRGB(70, 160, 255),
	Legendary = Color3.fromRGB(255, 184, 40),
}

-- One trail per title tier (see Shared/Progression.Titles).
Cosmetics.Trails = {
	ColorSequence.new(Color3.fromRGB(255, 255, 255)),
	ColorSequence.new(Color3.fromRGB(90, 230, 255)),
	ColorSequence.new(Color3.fromRGB(140, 255, 90)),
	ColorSequence.new(Color3.fromRGB(255, 150, 40), Color3.fromRGB(255, 70, 40)),
	ColorSequence.new(Color3.fromRGB(255, 80, 220), Color3.fromRGB(120, 80, 255)),
	ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 70, 70)),
		ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 220, 60)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(80, 255, 120)),
		ColorSequenceKeypoint.new(0.75, Color3.fromRGB(70, 160, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 90, 255)),
	}),
}

local HEAT_STOPS = {
	{ 0, Color3.fromRGB(255, 255, 255) },
	{ 50, Color3.fromRGB(255, 228, 92) },
	{ 100, Color3.fromRGB(255, 140, 40) },
	{ 150, Color3.fromRGB(255, 50, 50) },
	{ 220, Color3.fromRGB(190, 20, 60) },
}

function Cosmetics.HeatColor(heat: number): Color3
	if heat <= HEAT_STOPS[1][1] then
		return HEAT_STOPS[1][2]
	end
	for i = 2, #HEAT_STOPS do
		local prev, nextStop = HEAT_STOPS[i - 1], HEAT_STOPS[i]
		if heat <= nextStop[1] then
			local alpha = (heat - prev[1]) / (nextStop[1] - prev[1])
			return (prev[2] :: Color3):Lerp(nextStop[2] :: Color3, alpha)
		end
	end
	return HEAT_STOPS[#HEAT_STOPS][2]
end

function Cosmetics.TrailFor(tier: number): ColorSequence
	return Cosmetics.Trails[math.clamp(tier, 1, #Cosmetics.Trails)]
end

return Cosmetics
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000005">
				<Properties>
					<string name="Name">Draft</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Roguelike card draft: weighted rarity rolls with catch-up "luck" for players who placed low.
local Draft = {}

type PerkLike = { Id: string, Rarity: string, MaxStacks: number }
type RNG = { NextNumber: (any) -> number }

local ORDER = { "Common", "Rare", "Legendary" }

function Draft.Weights(luck: number): { [string]: number }
	luck = math.clamp(luck, 0, 1)
	return {
		Common = 70 - 40 * luck,
		Rare = 25 + 22 * luck,
		Legendary = 5 + 18 * luck,
	}
end

-- Returns up to `count` distinct perks from `pool`, skipping perks already at max stacks.
function Draft.Roll(pool: { PerkLike }, owned: { [string]: number }, count: number, luck: number, rng: RNG): { PerkLike }
	local weights = Draft.Weights(luck)
	local buckets: { [string]: { PerkLike } } = {}
	for _, def in pool do
		if (owned[def.Id] or 0) < def.MaxStacks and weights[def.Rarity] then
			local bucket = buckets[def.Rarity]
			if not bucket then
				bucket = {}
				buckets[def.Rarity] = bucket
			end
			table.insert(bucket, def)
		end
	end

	local picks = {}
	for _ = 1, count do
		local total = 0
		local lastNonEmpty: string? = nil
		for _, rarity in ORDER do
			local bucket = buckets[rarity]
			if bucket and #bucket > 0 then
				total += weights[rarity]
				lastNonEmpty = rarity
			end
		end
		if total <= 0 or not lastNonEmpty then
			break
		end

		local roll = rng:NextNumber() * total
		local chosen: string = lastNonEmpty
		for _, rarity in ORDER do
			local bucket = buckets[rarity]
			if bucket and #bucket > 0 then
				roll -= weights[rarity]
				if roll < 0 then
					chosen = rarity
					break
				end
			end
		end

		local bucket = buckets[chosen]
		local index = math.clamp(math.floor(rng:NextNumber() * #bucket) + 1, 1, #bucket)
		table.insert(picks, (table.remove(bucket, index) :: any) :: PerkLike)
	end
	return picks
end

return Draft
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000006">
				<Properties>
					<string name="Name">Knockback</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Pure knockback math (no Roblox APIs) so it can be unit tested outside Studio.
local Knockback = {}

export type Tuning = {
	HeatScale: number,
	VerticalRatio: number,
	VerticalBase: number,
	MaxKnockSpeed: number,
	TumbleBase: number,
	TumblePerSpeed: number,
	TumbleMax: number,
}

-- Horizontal launch speed in studs/sec. Heat makes everything hit harder.
function Knockback.Speed(base: number, heat: number, dealtMult: number, takenMult: number, tuning: Tuning): number
	local raw = base * dealtMult * takenMult * (1 + math.max(heat, 0) * tuning.HeatScale)
	return math.clamp(raw, 0, tuning.MaxKnockSpeed)
end

-- Upward speed paired with a horizontal launch so victims actually leave the ground.
function Knockback.Vertical(speed: number, tuning: Tuning): number
	return speed * tuning.VerticalRatio + tuning.VerticalBase
end

-- How long the victim tumbles (loses control) after a launch.
function Knockback.Tumble(speed: number, tuning: Tuning): number
	return math.min(tuning.TumbleBase + speed * tuning.TumblePerSpeed, tuning.TumbleMax)
end

-- Ballistic horizontal distance on flat ground, ignoring friction. Used for tuning and tests.
function Knockback.FlightDistance(speed: number, tuning: Tuning, gravity: number): number
	local vy = Knockback.Vertical(speed, tuning)
	return speed * (2 * vy / gravity)
end

-- 1 = cool, 2 = warm, 3 = hot, 4 = critical
function Knockback.HeatTier(heat: number): number
	if heat >= 150 then
		return 4
	elseif heat >= 100 then
		return 3
	elseif heat >= 50 then
		return 2
	end
	return 1
end

return Knockback
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000007">
				<Properties>
					<string name="Name">Movement</string>
					<ProtectedString name="Source"><![CDATA[-- Physical movement shared by clients (their own character) and the server (bots).
-- Whoever owns a character's physics must be the one to move it, so both sides use this.
local Movement = {}

local tumbleTokens: { [Humanoid]: number } = setmetatable({}, { __mode = "k" }) :: any
local random = Random.new()

local function nextToken(humanoid: Humanoid): number
	local token = (tumbleTokens[humanoid] or 0) + 1
	tumbleTokens[humanoid] = token
	return token
end

function Movement.Recover(humanoid: Humanoid)
	if humanoid.Parent and humanoid.Health > 0 then
		humanoid.PlatformStand = false
		humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
end

function Movement.IsTumbling(humanoid: Humanoid): boolean
	return humanoid.PlatformStand
end

function Movement.CancelTumble(humanoid: Humanoid)
	nextToken(humanoid)
	if humanoid.PlatformStand then
		Movement.Recover(humanoid)
	end
end

-- Launch a character. `tumble` seconds of ragdoll-ish loss of control; 0 just sets velocity.
function Movement.Knockback(humanoid: Humanoid, root: BasePart, velocity: Vector3, tumble: number)
	if not humanoid.Parent or not root.Parent then
		return
	end
	local token = nextToken(humanoid)
	if tumble > 0 then
		humanoid.PlatformStand = true
	end
	root.AssemblyLinearVelocity = velocity
	if tumble > 0 and velocity.Magnitude > 1 then
		local spin = math.clamp(velocity.Magnitude / 60, 0.3, 2)
		root.AssemblyAngularVelocity = Vector3.new(
			random:NextNumber(-8, 8),
			random:NextNumber(-4, 4),
			random:NextNumber(-8, 8)
		) * spin
	end
	if tumble > 0 then
		task.delay(tumble, function()
			if tumbleTokens[humanoid] == token then
				Movement.Recover(humanoid)
			end
		end)
	end
end

export type DashTuning = { DashSpeed: number, DashDuration: number, AirDashLift: number }

-- Short, snappy burst. Cancels tumble so it doubles as a recovery move.
function Movement.Dash(humanoid: Humanoid, root: BasePart, direction: Vector3, tuning: DashTuning)
	if not humanoid.Parent or not root.Parent then
		return
	end
	Movement.CancelTumble(humanoid)
	local airborne = humanoid.FloorMaterial == Enum.Material.Air

	local old = root:FindFirstChild("DashVelocity")
	if old then
		old:Destroy()
	end
	local attachment = root:FindFirstChild("DashAttachment") :: Attachment?
	if not attachment then
		local created = Instance.new("Attachment")
		created.Name = "DashAttachment"
		created.Parent = root
		attachment = created
	end

	local mover = Instance.new("LinearVelocity")
	mover.Name = "DashVelocity"
	mover.Attachment0 = attachment
	mover.RelativeTo = Enum.ActuatorRelativeTo.World
	mover.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	mover.MaxForce = math.huge
	mover.VectorVelocity = direction * tuning.DashSpeed + Vector3.new(0, if airborne then tuning.AirDashLift else 0, 0)
	mover.Parent = root

	task.delay(tuning.DashDuration, function()
		if mover.Parent then
			mover:Destroy()
		end
	end)
end

return Movement
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000008">
				<Properties>
					<string name="Name">Net</string>
					<ProtectedString name="Source"><![CDATA[-- Single source of truth for remotes. The server creates them; clients wait for them.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = {}

local REMOTE_NAMES = {
	-- client -> server
	"ChargeStart",
	"Punch",
	"Dash",
	"DraftPick",
	-- server -> client
	"Knockback",
	"Effect",
	"Announce",
	"KillFeed",
	"DraftOffer",
	"DraftClose",
	"MatchResults",
}

local IS_SERVER = RunService:IsServer()
local remoteFolder: Folder? = nil

local function getFolder(): Folder
	if remoteFolder then
		return remoteFolder
	end
	if IS_SERVER then
		local folder = ReplicatedStorage:FindFirstChild("Remotes")
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = "Remotes"
			folder.Parent = ReplicatedStorage
		end
		for _, name in REMOTE_NAMES do
			if not folder:FindFirstChild(name) then
				local remote = Instance.new("RemoteEvent")
				remote.Name = name
				remote.Parent = folder
			end
		end
		remoteFolder = folder
	else
		remoteFolder = ReplicatedStorage:WaitForChild("Remotes") :: Folder
	end
	return remoteFolder :: Folder
end

function Net.Event(name: string): RemoteEvent
	assert(table.find(REMOTE_NAMES, name), "Unknown remote: " .. tostring(name))
	local folder = getFolder()
	if IS_SERVER then
		return folder:FindFirstChild(name) :: RemoteEvent
	end
	return folder:WaitForChild(name) :: RemoteEvent
end

-- Replicated folder whose attributes describe the current match state (late-join safe).
function Net.GameState(): Folder
	if IS_SERVER then
		local state = ReplicatedStorage:FindFirstChild("GameState")
		if not state then
			state = Instance.new("Folder")
			state.Name = "GameState"
			state.Parent = ReplicatedStorage
		end
		return state :: Folder
	end
	return ReplicatedStorage:WaitForChild("GameState") :: Folder
end

return Net
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000009">
				<Properties>
					<string name="Name">Perks</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Perk definitions and stat aggregation. Pure Luau so it is unit-testable.
local Perks = {}

export type Stats = {
	KnockDealt: number,
	KnockTaken: number,
	HeatDealt: number,
	HeatTaken: number,
	WalkSpeed: number,
	JumpPower: number,
	PunchCooldownMult: number,
	DashCooldownMult: number,
	DashCharges: number,
	LifeSteal: number,
	ExtraLives: number,
	ChargeSpeed: number,
	BumpMult: number,
	Thorns: number,
	Shockwave: number,
	Scale: number,
}

export type PerkDef = {
	Id: string,
	Name: string,
	Rarity: string,
	MaxStacks: number,
	UnlockLevel: number,
	Description: string,
	Apply: (Stats) -> (),
}

Perks.RarityOrder = { "Common", "Rare", "Legendary" }

function Perks.BaseStats(): Stats
	return {
		KnockDealt = 1,
		KnockTaken = 1,
		HeatDealt = 1,
		HeatTaken = 1,
		WalkSpeed = 16,
		JumpPower = 50,
		PunchCooldownMult = 1,
		DashCooldownMult = 1,
		DashCharges = 1,
		LifeSteal = 0,
		ExtraLives = 0,
		ChargeSpeed = 1,
		BumpMult = 1,
		Thorns = 0,
		Shockwave = 0,
		Scale = 1,
	}
end

local function perk(id: string, name: string, rarity: string, maxStacks: number, unlockLevel: number, description: string, apply: (Stats) -> ()): PerkDef
	return {
		Id = id,
		Name = name,
		Rarity = rarity,
		MaxStacks = maxStacks,
		UnlockLevel = unlockLevel,
		Description = description,
		Apply = apply,
	}
end

Perks.List = {
	-- Common
	perk("rocket_fist", "Rocket Fist", "Common", 5, 1, "+15% knockback dealt.", function(s)
		s.KnockDealt += 0.15
	end),
	perk("heavyweight", "Heavyweight", "Common", 4, 1, "-12% knockback taken, slightly slower.", function(s)
		s.KnockTaken -= 0.12
		s.WalkSpeed -= 1
	end),
	perk("turbo_sneakers", "Turbo Sneakers", "Common", 4, 1, "+2.5 walk speed.", function(s)
		s.WalkSpeed += 2.5
	end),
	perk("quick_jab", "Quick Jab", "Common", 3, 1, "Punch cooldown -15%.", function(s)
		s.PunchCooldownMult -= 0.15
	end),
	perk("spring_legs", "Spring Legs", "Common", 3, 1, "+10 jump power.", function(s)
		s.JumpPower += 10
	end),
	perk("second_gear", "Second Gear", "Common", 3, 1, "Dash cooldown -20%.", function(s)
		s.DashCooldownMult -= 0.2
	end),
	perk("thick_skin", "Thick Skin", "Common", 4, 1, "Take 15% less heat.", function(s)
		s.HeatTaken -= 0.15
	end),
	perk("spicy_knuckles", "Spicy Knuckles", "Common", 4, 1, "Deal 20% more heat.", function(s)
		s.HeatDealt += 0.2
	end),
	-- Rare
	perk("double_dash", "Double Dash", "Rare", 2, 1, "+1 dash charge. Recover like a pro.", function(s)
		s.DashCharges += 1
	end),
	perk("vampire_fist", "Vampire Fist", "Rare", 3, 1, "Every hit cools your own heat by 4%.", function(s)
		s.LifeSteal += 4
	end),
	perk("spiked_armor", "Spiked Armor", "Rare", 2, 2, "Attackers take 35% of the heat they deal you.", function(s)
		s.Thorns += 0.35
	end),
	perk("bumper_car", "Bumper Car", "Rare", 2, 2, "Dash bumps hit twice as hard.", function(s)
		s.BumpMult += 1
	end),
	perk("overcharger", "Overcharger", "Rare", 2, 4, "Charge punches 40% faster.", function(s)
		s.ChargeSpeed += 0.4
	end),
	-- Legendary
	perk("second_wind", "Second Wind", "Legendary", 2, 1, "Once per round, the void spits you back out.", function(s)
		s.ExtraLives += 1
	end),
	perk("glass_cannon", "Glass Cannon", "Legendary", 2, 3, "+50% knockback dealt, +35% knockback taken.", function(s)
		s.KnockDealt += 0.5
		s.KnockTaken += 0.35
	end),
	perk("titan", "Titan", "Legendary", 2, 5, "Grow 20% bigger. Harder to move, hits harder, a bit slower.", function(s)
		s.Scale += 0.2
		s.KnockTaken -= 0.2
		s.KnockDealt += 0.1
		s.WalkSpeed -= 1.5
	end),
	perk("shockwave_fist", "Shockwave Fist", "Legendary", 1, 7, "Charged punches blast EVERYONE around you.", function(s)
		s.Shockwave += 1
	end),
}

Perks.ById = {} :: { [string]: PerkDef }
for _, def in Perks.List do
	Perks.ById[def.Id] = def
end

-- Builds final stats from an owned-perk map { [perkId] = stacks }. Order is deterministic.
function Perks.Compute(owned: { [string]: number }): Stats
	local stats = Perks.BaseStats()
	for _, def in Perks.List do
		local stacks = math.min(owned[def.Id] or 0, def.MaxStacks)
		for _ = 1, stacks do
			def.Apply(stats)
		end
	end
	stats.KnockTaken = math.max(stats.KnockTaken, 0.4)
	stats.HeatTaken = math.max(stats.HeatTaken, 0.4)
	stats.WalkSpeed = math.max(stats.WalkSpeed, 10)
	stats.PunchCooldownMult = math.max(stats.PunchCooldownMult, 0.45)
	stats.DashCooldownMult = math.max(stats.DashCooldownMult, 0.35)
	stats.DashCharges = math.floor(stats.DashCharges)
	return stats
end

-- Perks a player of the given level can be offered.
function Perks.Pool(level: number): { PerkDef }
	local pool = {}
	for _, def in Perks.List do
		if def.UnlockLevel <= level then
			table.insert(pool, def)
		end
	end
	return pool
end

return Perks
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000000A">
				<Properties>
					<string name="Name">Progression</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Persistent progression math: levels, titles and match XP. Pure Luau.
local Progression = {}

Progression.MaxLevel = 100

Progression.Titles = {
	{ Level = 1, Name = "Rookie" },
	{ Level = 3, Name = "Brawler" },
	{ Level = 5, Name = "Bruiser" },
	{ Level = 8, Name = "Launcher" },
	{ Level = 12, Name = "Yeetmaster" },
	{ Level = 20, Name = "Living Legend" },
}

-- XP needed to advance from `level` to `level + 1`.
function Progression.XPForLevel(level: number): number
	return 100 + (level - 1) * 60
end

-- Returns level, xp into the current level, xp needed for the next level.
function Progression.FromXP(totalXP: number): (number, number, number)
	local level = 1
	local remaining = math.max(0, math.floor(totalXP))
	while level < Progression.MaxLevel and remaining >= Progression.XPForLevel(level) do
		remaining -= Progression.XPForLevel(level)
		level += 1
	end
	return level, remaining, Progression.XPForLevel(level)
end

-- Returns tier index (1-based, also used for trail colours) and title name.
function Progression.TitleFor(level: number): (number, string)
	local tier, name = 1, Progression.Titles[1].Name
	for index, entry in Progression.Titles do
		if level >= entry.Level then
			tier, name = index, entry.Name
		end
	end
	return tier, name
end

export type MatchResult = {
	Points: number,
	KOs: number,
	Placement: number,
	Won: boolean,
	DailyBonus: boolean,
}

function Progression.MatchXP(result: MatchResult): (number, { string })
	local breakdown = {}
	local xp = 25
	table.insert(breakdown, "Played a match +25")
	if result.Points > 0 then
		xp += result.Points * 12
		table.insert(breakdown, string.format("%d points +%d", result.Points, result.Points * 12))
	end
	if result.KOs > 0 then
		xp += result.KOs * 5
		table.insert(breakdown, string.format("%d KOs +%d", result.KOs, result.KOs * 5))
	end
	if result.Won then
		xp += 75
		table.insert(breakdown, "Champion +75")
	elseif result.Placement == 2 then
		xp += 35
		table.insert(breakdown, "2nd place +35")
	elseif result.Placement == 3 then
		xp += 20
		table.insert(breakdown, "3rd place +20")
	end
	if result.Won and result.DailyBonus then
		xp *= 2
		table.insert(breakdown, "First win of the day x2")
	end
	return math.floor(xp), breakdown
end

return Progression
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
	<Item class="ServerScriptService" referent="RBX0000000B">
		<Properties>
			<string name="Name">ServerScriptService</string>
		</Properties>
		<Item class="Script" referent="RBX0000000C">
			<Properties>
				<string name="Name">Server</string>
				<ProtectedString name="Source"><![CDATA[-- LAUNCH PARTY server bootstrap. Order matters: world -> data -> systems -> match loop.
local Services = script:WaitForChild("Services")

local ArenaService = require(Services.ArenaService)
local BotService = require(Services.BotService)
local CombatService = require(Services.CombatService)
local DataService = require(Services.DataService)
local DraftService = require(Services.DraftService)
local RoundService = require(Services.RoundService)

local Config = require(game:GetService("ReplicatedStorage").Shared.Config)

ArenaService.SetupWorld()
DataService.Init()
CombatService.Init()
BotService.Init()
DraftService.Init()
RoundService.Init()

-- Practice dummies in the lobby so there's always something to launch.
local lobby = Config.Lobby.Center
BotService.CreateDummy(CFrame.new(lobby + Vector3.new(-20, 4, -6)) * CFrame.Angles(0, math.rad(180), 0))
BotService.CreateDummy(CFrame.new(lobby + Vector3.new(20, 4, -6)) * CFrame.Angles(0, math.rad(180), 0))

RoundService.Start()
print("[LaunchParty] Server ready.")
]]></ProtectedString>
			</Properties>
			<Item class="Folder" referent="RBX0000000D">
				<Properties>
					<string name="Name">Services</string>
				</Properties>
				<Item class="ModuleScript" referent="RBX0000000E">
					<Properties>
						<string name="Name">ArenaService</string>
						<ProtectedString name="Source"><![CDATA[-- Builds the world: lighting, the spectator lobby and a fresh floating-island arena every round.
local Debris = game:GetService("Debris")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)

local ArenaService = {}

local ARENA = Config.Arena
local LOBBY = Config.Lobby

local GRASS_A = Color3.fromRGB(116, 206, 92)
local GRASS_B = Color3.fromRGB(98, 186, 80)
local DIRT = Color3.fromRGB(126, 88, 62)
local WARN = Color3.fromRGB(255, 96, 64)
local ICE = Color3.fromRGB(190, 230, 255)

type Tile = {
	Model: Model,
	Top: BasePart,
	Position: Vector3, -- centre of the tile's top surface
	Dist: number, -- flat distance from arena centre
	Alive: boolean,
}

local arenaFolder: Folder? = nil
local tiles: { Tile } = {}
local rng = Random.new()
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include

local function makePart(props: { [string]: any }): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	local parent = props.Parent
	for key, value in props do
		if key ~= "Parent" then
			(part :: any)[key] = value
		end
	end
	if parent then
		part.Parent = parent
	end
	return part
end

local function makeSign(part: BasePart, face: Enum.NormalId, lines: { { Text: string, Size: number, Color: Color3 } })
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 20
	gui.LightInfluence = 0
	gui.Parent = part

	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Vertical
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Padding = UDim.new(0, 6)
	layout.Parent = gui

	for index, line in lines do
		local label = Instance.new("TextLabel")
		label.LayoutOrder = index
		label.BackgroundTransparency = 1
		label.Size = UDim2.new(0.94, 0, line.Size, 0)
		label.Font = if index == 1 then Enum.Font.FredokaOne else Enum.Font.GothamBold
		label.TextScaled = true
		label.TextColor3 = line.Color
		label.TextStrokeTransparency = 0.3
		label.Text = line.Text
		label.Parent = gui
	end
end

-- Arena shapes: predicates over flat offsets from the centre.
local SHAPES: { [string]: (number, number, number) -> boolean } = {
	Disc = function(x, z, r)
		return x * x + z * z <= r * r
	end,
	Cross = function(x, z, r)
		local width = r * 0.36
		return (math.abs(x) <= width or math.abs(z) <= width) and math.max(math.abs(x), math.abs(z)) <= r
	end,
	Donut = function(x, z, r)
		local d = math.sqrt(x * x + z * z)
		return d <= r and d >= r * 0.32
	end,
	Twin = function(x, z, r)
		local islandR = r * 0.48
		local left, right = x + r * 0.5, x - r * 0.5
		return left * left + z * z <= islandR * islandR
			or right * right + z * z <= islandR * islandR
			or (math.abs(z) <= 4 and math.abs(x) <= r * 0.5)
	end,
}

ArenaService.ShapeNames = { "Disc", "Cross", "Donut", "Twin" }
ArenaService.ShapeTitles = {
	Disc = "The Disc",
	Cross = "Crossroads",
	Donut = "Donut Hole",
	Twin = "Twin Isles",
}

local function setupLighting()
	Lighting.ClockTime = 14.5
	Lighting.Brightness = 2.2
	Lighting.Ambient = Color3.fromRGB(95, 95, 115)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 150, 172)
	Lighting.GlobalShadows = true

	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmosphere.Density = 0.32
	atmosphere.Offset = 0.15
	atmosphere.Color = Color3.fromRGB(198, 220, 255)
	atmosphere.Decay = Color3.fromRGB(110, 150, 210)
	atmosphere.Glare = 0.2
	atmosphere.Haze = 1.2
	atmosphere.Parent = Lighting

	if not Lighting:FindFirstChild("LP_Bloom") then
		local bloom = Instance.new("BloomEffect")
		bloom.Name = "LP_Bloom"
		bloom.Intensity = 0.6
		bloom.Size = 24
		bloom.Threshold = 1.6
		bloom.Parent = Lighting
	end
	if not Lighting:FindFirstChild("LP_Color") then
		local color = Instance.new("ColorCorrectionEffect")
		color.Name = "LP_Color"
		color.Saturation = 0.15
		color.Contrast = 0.05
		color.Parent = Lighting
	end
end

local function buildScenery()
	local folder = Instance.new("Folder")
	folder.Name = "Scenery"

	-- A cloud sea far below the arena so the void reads as "very, very far down".
	makePart({
		Name = "CloudSea",
		Size = Vector3.new(2048, 1, 2048),
		CFrame = CFrame.new(ARENA.Center - Vector3.new(0, 70, 0)),
		Color = Color3.fromRGB(245, 248, 255),
		Material = Enum.Material.SmoothPlastic,
		Transparency = 0.25,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CastShadow = false,
		Parent = folder,
	})

	-- Distant floating islands for depth.
	for i = 1, 9 do
		local angle = (i / 9) * math.pi * 2 + rng:NextNumber(-0.25, 0.25)
		local distance = rng:NextNumber(115, 190)
		local width = rng:NextNumber(10, 24)
		local base = ARENA.Center + Vector3.new(math.cos(angle) * distance, rng:NextNumber(-30, 35), math.sin(angle) * distance)
		makePart({
			Name = "IslandTop",
			Size = Vector3.new(width, 3, width * rng:NextNumber(0.7, 1.2)),
			CFrame = CFrame.new(base) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0),
			Color = GRASS_A,
			Material = Enum.Material.Grass,
			Parent = folder,
		})
		makePart({
			Name = "IslandRock",
			Size = Vector3.new(width * 0.7, width * 0.6, width * 0.7),
			CFrame = CFrame.new(base - Vector3.new(0, 1.5 + width * 0.3, 0)) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0),
			Color = DIRT,
			Material = Enum.Material.Rock,
			Parent = folder,
		})
		if rng:NextNumber() < 0.7 then
			local trunkHeight = rng:NextNumber(5, 9)
			makePart({
				Name = "Trunk",
				Size = Vector3.new(1.4, trunkHeight, 1.4),
				CFrame = CFrame.new(base + Vector3.new(0, 1.5 + trunkHeight / 2, 0)),
				Color = Color3.fromRGB(110, 76, 50),
				Material = Enum.Material.Wood,
				Parent = folder,
			})
			makePart({
				Name = "Leaves",
				Shape = Enum.PartType.Ball,
				Size = Vector3.one * rng:NextNumber(6, 9),
				CFrame = CFrame.new(base + Vector3.new(0, 1.5 + trunkHeight + 1.5, 0)),
				Color = Color3.fromRGB(70, 170, 80),
				Material = Enum.Material.Grass,
				Parent = folder,
			})
		end
	end

	folder.Parent = Workspace
end

local function buildLobby()
	local folder = Instance.new("Folder")
	folder.Name = "Lobby"
	local c = LOBBY.Center
	local size = LOBBY.Size
	local halfX, halfZ = size.X / 2, size.Z / 2

	makePart({
		Name = "Floor",
		Size = size,
		CFrame = CFrame.new(c - Vector3.new(0, size.Y / 2, 0)),
		Color = Color3.fromRGB(58, 62, 84),
		Material = Enum.Material.Slate,
		Parent = folder,
	})
	-- Neon trim along the balcony edge facing the arena.
	makePart({
		Name = "Trim",
		Size = Vector3.new(size.X, 0.3, 1),
		CFrame = CFrame.new(c.X, c.Y + 0.05, c.Z - halfZ + 0.5),
		Color = Color3.fromRGB(255, 200, 60),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = folder,
	})
	makePart({
		Name = "BalconyGlass",
		Size = Vector3.new(size.X, 3.5, 0.5),
		CFrame = CFrame.new(c.X, c.Y + 1.75, c.Z - halfZ),
		Color = Color3.fromRGB(170, 220, 255),
		Material = Enum.Material.Glass,
		Transparency = 0.55,
		Parent = folder,
	})

	-- Invisible walls so nobody can leave the lobby (or get launched out of it).
	local wallHeight = 45
	local walls = {
		{ Vector3.new(size.X, wallHeight, 1), Vector3.new(0, wallHeight / 2, -halfZ - 0.5) },
		{ Vector3.new(size.X, wallHeight, 1), Vector3.new(0, wallHeight / 2, halfZ + 0.5) },
		{ Vector3.new(1, wallHeight, size.Z), Vector3.new(-halfX - 0.5, wallHeight / 2, 0) },
		{ Vector3.new(1, wallHeight, size.Z), Vector3.new(halfX + 0.5, wallHeight / 2, 0) },
		{ Vector3.new(size.X, 1, size.Z), Vector3.new(0, wallHeight, 0) },
	}
	for index, wall in walls do
		makePart({
			Name = "Barrier" .. index,
			Size = wall[1],
			CFrame = CFrame.new(c + wall[2]),
			Transparency = 1,
			CanQuery = false,
			CastShadow = false,
			Parent = folder,
		})
	end

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "LobbySpawn"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Size = Vector3.new(14, 1, 14)
	spawn.CFrame = CFrame.new(c + Vector3.new(0, 0.5, 9)) -- default orientation faces -Z, toward the arena
	spawn.Color = Color3.fromRGB(255, 200, 60)
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = folder

	local title = makePart({
		Name = "TitleSign",
		Size = Vector3.new(60, 18, 1),
		CFrame = CFrame.new(c.X, c.Y + 13, c.Z + halfZ - 0.5),
		Color = Color3.fromRGB(30, 32, 48),
		Material = Enum.Material.SmoothPlastic,
		Parent = folder,
	})
	makeSign(title, Enum.NormalId.Front, {
		{ Text = Config.GameName, Size = 0.55, Color = Color3.fromRGB(255, 205, 60) },
		{ Text = "Build heat. Launch friends. Don't be the one who falls.", Size = 0.16, Color = Color3.new(1, 1, 1) },
	})

	local howTo = makePart({
		Name = "HowToBoard",
		Size = Vector3.new(30, 16, 1),
		CFrame = CFrame.new(c.X - halfX + 0.5, c.Y + 9, c.Z + 2) * CFrame.Angles(0, -math.pi / 2, 0),
		Color = Color3.fromRGB(30, 32, 48),
		Parent = folder,
	})
	makeSign(howTo, Enum.NormalId.Front, {
		{ Text = "HOW TO PLAY", Size = 0.2, Color = Color3.fromRGB(90, 230, 255) },
		{ Text = "CLICK to punch.  HOLD to charge a launcher.", Size = 0.1, Color = Color3.new(1, 1, 1) },
		{ Text = "Q / SHIFT to dash. Works in mid-air!", Size = 0.1, Color = Color3.new(1, 1, 1) },
		{ Text = "Hits raise HEAT. More heat = you fly further.", Size = 0.1, Color = Color3.fromRGB(255, 200, 80) },
		{ Text = "Fall into the void and you're out.", Size = 0.1, Color = Color3.fromRGB(255, 120, 120) },
		{ Text = "Last one standing wins the round.", Size = 0.1, Color = Color3.new(1, 1, 1) },
	})

	local draftBoard = makePart({
		Name = "DraftBoard",
		Size = Vector3.new(30, 16, 1),
		CFrame = CFrame.new(c.X + halfX - 0.5, c.Y + 9, c.Z + 2) * CFrame.Angles(0, math.pi / 2, 0),
		Color = Color3.fromRGB(30, 32, 48),
		Parent = folder,
	})
	makeSign(draftBoard, Enum.NormalId.Front, {
		{ Text = "THE DRAFT", Size = 0.2, Color = Color3.fromRGB(255, 184, 40) },
		{ Text = "After each round, pick 1 of 3 perks. They stack!", Size = 0.1, Color = Color3.new(1, 1, 1) },
		{ Text = "Placed low? You get luckier cards.", Size = 0.1, Color = Color3.new(1, 1, 1) },
		{ Text = "The leader wears the crown. KO them for a bounty.", Size = 0.1, Color = Color3.fromRGB(255, 220, 90) },
		{ Text = "Level up to unlock new perks, titles & trails.", Size = 0.1, Color = Color3.fromRGB(140, 255, 90) },
		{ Text = "Punch the dummies while you wait!", Size = 0.1, Color = Color3.new(1, 1, 1) },
	})

	folder.Parent = Workspace
end

function ArenaService.SetupWorld()
	setupLighting()
	buildScenery()
	buildLobby()
	Workspace.Gravity = Config.Events.DefaultGravity
end

function ArenaService.Clear()
	if arenaFolder then
		arenaFolder:Destroy()
		arenaFolder = nil
	end
	table.clear(tiles)
end

function ArenaService.Build(shapeName: string)
	ArenaService.Clear()
	local shape = SHAPES[shapeName] or SHAPES.Disc
	local folder = Instance.new("Folder")
	folder.Name = "Arena"
	rayParams.FilterDescendantsInstances = { folder }

	local tileSize = ARENA.TileSize
	local n = math.ceil(ARENA.Radius / tileSize)
	local center = ARENA.Center

	for gx = -n, n do
		for gz = -n, n do
			local x, z = gx * tileSize, gz * tileSize
			if shape(x, z, ARENA.Radius) then
				local model = Instance.new("Model")
				model.Name = "Tile"
				local top = makePart({
					Name = "Top",
					Size = Vector3.new(tileSize, 1.4, tileSize),
					CFrame = CFrame.new(center + Vector3.new(x, -0.7, z)),
					Color = if (gx + gz) % 2 == 0 then GRASS_A else GRASS_B,
					Material = Enum.Material.Grass,
					Parent = model,
				})
				local depth = 3 + rng:NextNumber() * 4
				local dirt = makePart({
					Name = "Dirt",
					Anchored = false,
					Massless = true,
					Size = Vector3.new(tileSize - 0.5, depth, tileSize - 0.5),
					CFrame = CFrame.new(center + Vector3.new(x, -1.4 - depth / 2, z)),
					Color = DIRT:Lerp(Color3.new(0, 0, 0), rng:NextNumber() * 0.15),
					Material = Enum.Material.Ground,
					Parent = model,
				})
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = top
				weld.Part1 = dirt
				weld.Parent = top
				model.PrimaryPart = top
				model.Parent = folder

				table.insert(tiles, {
					Model = model,
					Top = top,
					Position = center + Vector3.new(x, 0, z),
					Dist = math.sqrt(x * x + z * z),
					Alive = true,
				})
			end
		end
	end

	folder.Parent = Workspace
	arenaFolder = folder
end

function ArenaService.AliveTileCount(): number
	local count = 0
	for _, tile in tiles do
		if tile.Alive then
			count += 1
		end
	end
	return count
end

-- Evenly spaced spawn points around the arena, all facing the centre.
function ArenaService.GetSpawnCFrames(count: number): { CFrame }
	local center = ARENA.Center
	local used: { [Tile]: boolean } = {}
	local result = {}
	local ringRadius = ARENA.Radius * 0.55
	local offset = rng:NextNumber() * math.pi * 2

	for i = 1, count do
		local angle = offset + (i - 1) / count * math.pi * 2
		local target = center + Vector3.new(math.cos(angle) * ringRadius, 0, math.sin(angle) * ringRadius)
		local best: Tile? = nil
		local bestDist = math.huge
		for _, tile in tiles do
			if tile.Alive and not used[tile] then
				local d = (tile.Position - target).Magnitude
				if d < bestDist then
					best, bestDist = tile, d
				end
			end
		end
		local position = center
		if best then
			used[best] = true
			position = best.Position
		end
		local spawnPos = position + Vector3.new(0, 4, 0)
		local lookAt = Vector3.new(center.X, spawnPos.Y, center.Z)
		if (lookAt - spawnPos).Magnitude < 0.5 then
			lookAt = spawnPos + Vector3.new(0, 0, -1)
		end
		table.insert(result, CFrame.lookAt(spawnPos, lookAt))
	end
	return result
end

-- The most central surviving tile; used by Second Wind.
function ArenaService.GetSafeCFrame(): CFrame
	local best: Tile? = nil
	for _, tile in tiles do
		if tile.Alive and (not best or tile.Dist < best.Dist) then
			best = tile
		end
	end
	local position = if best then best.Position else ARENA.Center
	return CFrame.new(position + Vector3.new(0, 6, 0))
end

function ArenaService.RandomTilePosition(): Vector3?
	local alive = {}
	for _, tile in tiles do
		if tile.Alive then
			table.insert(alive, tile)
		end
	end
	if #alive == 0 then
		return nil
	end
	return alive[rng:NextInteger(1, #alive)].Position
end

-- True if there is solid, non-crumbling floor beneath `position`.
function ArenaService.IsOverArena(position: Vector3): boolean
	if not arenaFolder then
		return false
	end
	local result = Workspace:Raycast(position + Vector3.new(0, 2, 0), Vector3.new(0, -60, 0), rayParams)
	if not result then
		return false
	end
	local model = result.Instance.Parent
	return model ~= nil and model:IsA("Model") and not model:GetAttribute("Crumbling")
end

local function crumble(tile: Tile, warnTime: number)
	if not tile.Alive then
		return
	end
	tile.Alive = false
	tile.Model:SetAttribute("Crumbling", true)
	local top = tile.Top
	TweenService:Create(top, TweenInfo.new(warnTime), { Color = WARN }):Play()

	task.spawn(function()
		local base = top.CFrame
		local started = os.clock()
		while top.Parent and os.clock() - started < warnTime do
			local intensity = 0.05 + 0.2 * ((os.clock() - started) / warnTime)
			top.CFrame = base
				* CFrame.new(rng:NextNumber(-intensity, intensity), 0, rng:NextNumber(-intensity, intensity))
			task.wait(0.05)
		end
		if top.Parent then
			top.CFrame = base
			top.Anchored = false
			top.AssemblyLinearVelocity = Vector3.new(0, -6, 0)
			top.AssemblyAngularVelocity = Vector3.new(rng:NextNumber(-1, 1), 0, rng:NextNumber(-1, 1))
			Debris:AddItem(tile.Model, 5)
		end
	end)
end

-- Sudden death: drop the outermost ring of tiles. Returns false once the arena can't shrink further.
function ArenaService.CrumbleStep(): boolean
	local alive = {}
	for _, tile in tiles do
		if tile.Alive then
			table.insert(alive, tile)
		end
	end
	if #alive <= ARENA.MinTiles then
		return false
	end
	table.sort(alive, function(a, b)
		return a.Dist > b.Dist
	end)
	local cutoff = alive[1].Dist - ARENA.TileSize * 0.6
	local maxRemove = #alive - ARENA.MinTiles
	local removed = 0
	for _, tile in alive do
		if tile.Dist < cutoff or removed >= maxRemove then
			break
		end
		crumble(tile, 1.4)
		removed += 1
	end
	return removed > 0
end

-- Knock out tiles around an impact (meteors). Never drops below MinTiles.
function ArenaService.BreakTilesNear(position: Vector3, radius: number)
	local budget = ArenaService.AliveTileCount() - ARENA.MinTiles
	for _, tile in tiles do
		if budget <= 0 then
			return
		end
		local offset = tile.Position - position
		if tile.Alive and Vector3.new(offset.X, 0, offset.Z).Magnitude <= radius then
			crumble(tile, 0.35)
			budget -= 1
		end
	end
end

function ArenaService.SetIce(enabled: boolean)
	for _, tile in tiles do
		if tile.Alive and tile.Top.Parent then
			if enabled then
				tile.Top.Material = Enum.Material.Ice
				tile.Top.Color = tile.Top.Color:Lerp(ICE, 0.75)
				tile.Top.CustomPhysicalProperties = PhysicalProperties.new(0.9, 0, 0, 100, 1)
			else
				tile.Top.Material = Enum.Material.Grass
				tile.Top.CustomPhysicalProperties = nil
			end
		end
	end
end

function ArenaService.GetCenter(): Vector3
	return ARENA.Center
end

function ArenaService.GetVoidY(): number
	return ARENA.Center.Y - ARENA.VoidDepth
end

function ArenaService.GetLobbyVoidY(): number
	return LOBBY.Center.Y - LOBBY.VoidDepth
end

function ArenaService.GetLobbySpawnCFrame(): CFrame
	return CFrame.new(LOBBY.Center + Vector3.new(0, 4, 9))
end

return ArenaService
]]></ProtectedString>
					</Properties>
