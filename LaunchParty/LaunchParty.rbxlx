					<Item class="ModuleScript" referent="RBX0000001A">
						<Properties>
							<string name="Name">DraftController</string>
							<ProtectedString name="Source"><![CDATA[-- Between-round card picker. Click, tap, press 1/2/3, or use a gamepad.
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Cosmetics = require(Shared:WaitForChild("Cosmetics"))
local Net = require(Shared:WaitForChild("Net"))

local EffectsController = require(script.Parent.EffectsController)
local UI = require(script.Parent.UI)

local DraftController = {}

local player = Players.LocalPlayer
local pickRemote = Net.Event("DraftPick")

local overlay: Frame? = nil
local picked = false
local cardButtons: { TextButton } = {}
local timerConnection: RBXScriptConnection? = nil

local function close()
	if timerConnection then
		timerConnection:Disconnect()
		timerConnection = nil
	end
	if overlay then
		overlay:Destroy()
		overlay = nil
	end
	table.clear(cardButtons)
	if GuiService.SelectedObject and not GuiService.SelectedObject:IsDescendantOf(player.PlayerGui) then
		GuiService.SelectedObject = nil
	end
end

local function choose(index: number)
	if picked or not overlay or not cardButtons[index] then
		return
	end
	picked = true
	pickRemote:FireServer(index)
	EffectsController.PlaySound(Config.Sounds.Pick, nil, 0.6, 1.2)
	for i, button in cardButtons do
		if i == index then
			UI.pop(button, 1.15, 0.3)
			local stroke = button:FindFirstChildOfClass("UIStroke")
			if stroke then
				stroke.Thickness = 5
			end
		else
			UI.tween(button, 0.25, { BackgroundTransparency = 0.7 })
			for _, child in button:GetDescendants() do
				if child:IsA("TextLabel") then
					UI.tween(child, 0.25, { TextTransparency = 0.6 })
				end
			end
		end
	end
	local status = overlay:FindFirstChild("Status") :: TextLabel?
	if status then
		status.Text = "Locked in! Waiting for everyone else…"
	end
end

local function buildCard(index: number, card: { [string]: any }, parent: Instance): TextButton
	local color = Cosmetics.RarityColors[card.Rarity] or Color3.new(1, 1, 1)
	local button = UI.new("TextButton", {
		Name = "Card" .. index,
		LayoutOrder = index,
		Size = UDim2.new(0, 210, 0, 270),
		BackgroundColor3 = Color3.fromRGB(28, 30, 46),
		AutoButtonColor = false,
		Text = "",
		Parent = parent,
	}, {
		UI.corner(16),
		UI.stroke(color, 3),
		UI.new("UIPadding", {
			PaddingTop = UDim.new(0, 12),
			PaddingBottom = UDim.new(0, 12),
			PaddingLeft = UDim.new(0, 12),
			PaddingRight = UDim.new(0, 12),
		}),
	})
	UI.new("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(170, 170, 190)),
		Parent = button,
	})

	UI.label({
		Name = "Rarity",
		Size = UDim2.new(1, 0, 0, 22),
		Font = UI.BodyFont,
		TextColor3 = color,
		Text = string.upper(card.Rarity),
		Parent = button,
	})
	UI.label({
		Name = "PerkName",
		Position = UDim2.new(0, 0, 0, 30),
		Size = UDim2.new(1, 0, 0, 56),
		Text = card.Name,
		Parent = button,
	})
	UI.label({
		Name = "Description",
		Position = UDim2.new(0, 0, 0, 96),
		Size = UDim2.new(1, 0, 0, 100),
		Font = UI.BodyFont,
		TextScaled = false,
		TextSize = 17,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextColor3 = Color3.fromRGB(220, 225, 240),
		Text = card.Description,
		Parent = button,
	})
	local owned = tonumber(card.Owned) or 0
	UI.label({
		Name = "Stacks",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, -24),
		Size = UDim2.new(1, 0, 0, 18),
		Font = UI.BodyFont,
		TextColor3 = Color3.fromRGB(170, 175, 195),
		Text = if owned > 0 then string.format("Owned %d / %d", owned, card.MaxStacks) else "NEW",
		Parent = button,
	})
	UI.label({
		Name = "Hotkey",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 20),
		Font = UI.BodyFont,
		TextColor3 = color,
		Text = string.format("[%d]", index),
		Parent = button,
	})

	button.MouseEnter:Connect(function()
		if not picked then
			UI.pop(button, 1.06, 0.15)
		end
	end)
	button.Activated:Connect(function()
		choose(index)
	end)
	return button
end

local function open(cards: { { [string]: any } }, endsAt: number)
	close()
	picked = false
	local gui = player.PlayerGui:FindFirstChild("LaunchPartyHUD") or player.PlayerGui

	local root = UI.new("Frame", {
		Name = "DraftOverlay",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		ZIndex = 10,
		Parent = gui,
	})
	overlay = root

	UI.label({
		Name = "Title",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.12, 0),
		Size = UDim2.new(0.8, 0, 0, 60),
		Text = "PICK A PERK",
		TextColor3 = Color3.fromRGB(255, 210, 70),
		Parent = root,
	})
	UI.label({
		Name = "Status",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.12, 64),
		Size = UDim2.new(0.8, 0, 0, 24),
		Font = UI.BodyFont,
		Text = "Perks stack for the rest of the match.",
		Parent = root,
	})

	local row = UI.new("Frame", {
		Name = "Cards",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.55),
		Size = UDim2.new(0, 690, 0, 290),
		BackgroundTransparency = 1,
		Parent = root,
	}, {
		UI.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 20),
		}),
	})
	-- Shrink the whole row on small (phone) screens.
	local scale = UI.new("UIScale", { Parent = row })
	local camera = Workspace.CurrentCamera
	if camera then
		scale.Scale = math.clamp(camera.ViewportSize.X / 760, 0.45, 1)
	end

	for index, card in cards do
		local button = buildCard(index, card, row)
		table.insert(cardButtons, button)
		UI.pop(button, 0.3, 0.25 + index * 0.08)
	end

	local timerBack = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.55, 170),
		Size = UDim2.new(0, 400, 0, 10),
		BackgroundColor3 = Color3.fromRGB(40, 42, 60),
		Parent = root,
	}, { UI.corner(5) })
	local timerFill = UI.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(255, 210, 70),
		Parent = timerBack,
	}, { UI.corner(5) })
	local total = math.max(endsAt - Workspace:GetServerTimeNow(), 0.1)
	timerConnection = RunService.RenderStepped:Connect(function()
		local remaining = math.max(endsAt - Workspace:GetServerTimeNow(), 0)
		timerFill.Size = UDim2.fromScale(remaining / total, 1)
	end)

	if UserInputService.GamepadEnabled and cardButtons[1] then
		GuiService.SelectedObject = cardButtons[1]
	end
end

function DraftController.Start()
	Net.Event("DraftOffer").OnClientEvent:Connect(function(cards, endsAt)
		if type(cards) == "table" and type(endsAt) == "number" and #cards > 0 then
			open(cards, endsAt)
		end
	end)
	Net.Event("DraftClose").OnClientEvent:Connect(close)

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed or not overlay then
			return
		end
		local keys = { [Enum.KeyCode.One] = 1, [Enum.KeyCode.Two] = 2, [Enum.KeyCode.Three] = 3 }
		local index = keys[input.KeyCode]
		if index then
			choose(index)
		end
	end)
end

return DraftController
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX0000001B">
						<Properties>
							<string name="Name">EffectsController</string>
							<ProtectedString name="Source"><![CDATA[-- Juice: applies knockback to our own character and renders every hit, blast and gust locally.
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Movement = require(Shared:WaitForChild("Movement"))
local Net = require(Shared:WaitForChild("Net"))

local State = require(script.Parent.State)

local EffectsController = {}

local player = Players.LocalPlayer
local random = Random.new()
local fxFolder: Folder

local shakeIntensity = 0
local shakeDecay = 0

local function getCharacter(): (Model?, Humanoid?, BasePart?)
	local character = player.Character
	if not character then
		return nil, nil, nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not humanoid or not root or humanoid.Health <= 0 then
		return nil, nil, nil
	end
	return character, humanoid, root
end

local function fxPart(props: { [string]: any }): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	for key, value in props do
		(part :: any)[key] = value
	end
	part.Parent = fxFolder
	return part
end

function EffectsController.PlaySound(soundId: string, position: Vector3?, volume: number?, pitch: number?)
	local sound = Instance.new("Sound")
	sound.SoundId = soundId
	sound.Volume = volume or 0.6
	sound.PlaybackSpeed = pitch or random:NextNumber(0.92, 1.08)
	if position then
		local holder = Instance.new("Attachment")
		holder.WorldPosition = position
		holder.Parent = Workspace.Terrain
		sound.RollOffMaxDistance = 220
		sound.Parent = holder
		Debris:AddItem(holder, 4)
	else
		sound.Parent = SoundService
		Debris:AddItem(sound, 4)
	end
	sound:Play()
end

function EffectsController.Shake(intensity: number, duration: number)
	if intensity > shakeIntensity then
		shakeIntensity = intensity
		shakeDecay = intensity / math.max(duration, 0.05)
	end
end

function EffectsController.FovKick(amount: number)
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local base = 70
	camera.FieldOfView = base + amount
	TweenService:Create(camera, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		FieldOfView = base,
	}):Play()
end

local function burst(position: Vector3, color: Color3, size: number, duration: number)
	local ball = fxPart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.one,
		CFrame = CFrame.new(position),
		Color = color,
		Transparency = 0.15,
	})
	TweenService:Create(ball, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.one * size,
		Transparency = 1,
	}):Play()
	Debris:AddItem(ball, duration + 0.05)
end

local function ring(position: Vector3, color: Color3, radius: number, duration: number)
	local disc = fxPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, 2, 2),
		CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90)),
		Color = color,
		Transparency = 0.2,
	})
	TweenService:Create(disc, TweenInfo.new(duration, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.3, radius * 2, radius * 2),
		Transparency = 1,
	}):Play()
	Debris:AddItem(disc, duration + 0.05)
end

local function shards(position: Vector3, color: Color3, count: number, speed: number)
	for _ = 1, count do
		local shard = fxPart({
			Anchored = false,
			Size = Vector3.one * random:NextNumber(0.3, 0.7),
			CFrame = CFrame.new(position) * CFrame.Angles(random:NextNumber(0, 6), random:NextNumber(0, 6), 0),
			Color = color,
		})
		shard.AssemblyLinearVelocity = random:NextUnitVector() * speed + Vector3.new(0, speed * 0.5, 0)
		Debris:AddItem(shard, 0.6)
	end
end

local function popupText(position: Vector3, text: string, color: Color3)
	local anchor = fxPart({ Size = Vector3.one * 0.2, Transparency = 1, CFrame = CFrame.new(position) })
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(110, 44)
	gui.StudsOffset = Vector3.new(random:NextNumber(-1, 1), 2.5, 0)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Parent = anchor
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color
	label.TextStrokeTransparency = 0
	label.Parent = gui
	TweenService:Create(gui, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		StudsOffset = gui.StudsOffset + Vector3.new(0, 3, 0),
	}):Play()
	TweenService:Create(label, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		TextTransparency = 1,
		TextStrokeTransparency = 1,
	}):Play()
	Debris:AddItem(anchor, 0.85)
end

-- Effect handlers ------------------------------------------------------------------------

local handlers: { [string]: (any) -> () } = {}

function handlers.Hit(data)
	local position: Vector3 = data.Position
	local speed: number = data.Speed or 30
	local strength = math.clamp(speed / 160, 0.15, 1)
	local charged = data.Kind == "Charged" or data.Kind == "Shockwave"
	local color = if charged
		then Color3.fromRGB(255, 160, 50)
		elseif data.Kind == "Bump" then Color3.fromRGB(90, 220, 255)
		else Color3.new(1, 1, 1)
	burst(position, color, 3 + strength * 7, 0.25)
	shards(position, color, math.floor(4 + strength * 8), 25 + strength * 40)
	if data.Heat and data.Heat > 0 then
		popupText(position, "+" .. data.Heat .. "%", if charged then Color3.fromRGB(255, 170, 60) else Color3.new(1, 1, 1))
	end
	EffectsController.PlaySound(Config.Sounds.Hit, position, 0.5 + strength * 0.6, 1.25 - strength * 0.4)

	local myId = State.MyId()
	if data.Attacker == myId then
		EffectsController.Shake(0.25 + strength * 0.5, 0.18)
		if charged then
			EffectsController.FovKick(6 + strength * 6)
		end
		local now = os.clock()
		State.Combo = if now - State.LastComboHit < 1.6 then State.Combo + 1 else 1
		State.LastComboHit = now
		State.ComboChanged:Fire(State.Combo)
	elseif data.Victim == myId then
		EffectsController.Shake(0.4 + strength * 1.1, 0.3)
	end
end

function handlers.KO(data)
	local position: Vector3 = data.Position
	local beamHeight = 160
	local beam = fxPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(beamHeight, 6, 6),
		CFrame = CFrame.new(position + Vector3.new(0, beamHeight / 2 - 10, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(255, 220, 90),
		Transparency = 0.1,
	})
	TweenService:Create(beam, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(beamHeight, 0.2, 0.2),
		Transparency = 1,
	}):Play()
	Debris:AddItem(beam, 1)
	burst(position, Color3.fromRGB(255, 240, 160), 26, 0.5)
	ring(position, Color3.fromRGB(255, 200, 80), 30, 0.7)
	EffectsController.PlaySound(Config.Sounds.KO, position, 1, 1)
	EffectsController.Shake(0.5, 0.35)
end

function handlers.Meteor(data)
	local position: Vector3 = data.Position
	burst(position, Color3.fromRGB(255, 120, 40), (data.Radius or 10) * 2, 0.45)
	ring(position, Color3.fromRGB(255, 80, 40), (data.Radius or 10) * 1.4, 0.5)
	shards(position, Color3.fromRGB(90, 60, 45), 14, 60)
	EffectsController.PlaySound(Config.Sounds.Boom, position, 1.2, 0.6)
	local _, _, root = getCharacter()
	if root and (root.Position - position).Magnitude < 45 then
		EffectsController.Shake(0.8, 0.4)
	end
end

function handlers.Shockwave(data)
	ring(data.Position, Color3.fromRGB(255, 170, 60), data.Radius or 12, 0.4)
	burst(data.Position, Color3.fromRGB(255, 200, 120), 8, 0.3)
end

function handlers.Dash(data)
	if data.Fighter == State.MyId() then
		return
	end
	ring(data.Position - Vector3.new(0, 2.5, 0), Color3.fromRGB(200, 240, 255), 4, 0.3)
end

function handlers.SecondWind(data)
	burst(data.Position, Color3.fromRGB(120, 255, 230), 14, 0.5)
	ring(data.Position, Color3.fromRGB(120, 255, 230), 12, 0.6)
end

local function windStreaks(direction: Vector3, center: Vector3, duration: number, transparency: number)
	local right = Vector3.new(-direction.Z, 0, direction.X)
	for _ = 1, 26 do
		local start = center
			- direction * 60
			+ right * random:NextNumber(-55, 55)
			+ Vector3.new(0, random:NextNumber(1, 12), 0)
		local streak = fxPart({
			Size = Vector3.new(0.25, 0.25, random:NextNumber(6, 14)),
			CFrame = CFrame.lookAt(start, start + direction),
			Color = Color3.new(1, 1, 1),
			Transparency = transparency,
		})
		TweenService:Create(streak, TweenInfo.new(duration * random:NextNumber(0.7, 1.2), Enum.EasingStyle.Linear), {
			CFrame = CFrame.lookAt(start + direction * 120, start + direction * 121),
			Transparency = 1,
		}):Play()
		Debris:AddItem(streak, duration * 1.3)
	end
end

function handlers.GustWarning(data)
	windStreaks(data.Direction, data.Center, 1.6, 0.8)
	State.BigMessage:Fire("💨 GUST INCOMING", "Small", "Brace yourself!")
end

function handlers.Gust(data)
	windStreaks(data.Direction, data.Center, 0.7, 0.3)
end

function handlers.RoundWin(data)
	if data.Fighter == State.MyId() then
		EffectsController.FovKick(-8)
	end
end

-- Lifecycle --------------------------------------------------------------------------------

function EffectsController.Start()
	fxFolder = Instance.new("Folder")
	fxFolder.Name = "ClientFX"
	fxFolder.Parent = Workspace

	Net.Event("Knockback").OnClientEvent:Connect(function(velocity, tumble)
		if typeof(velocity) ~= "Vector3" or type(tumble) ~= "number" then
			return
		end
		local _, humanoid, root = getCharacter()
		if not humanoid or not root then
			return
		end
		State.Charging = false
		if velocity.Magnitude > 0.5 then
			State.LastKnockback = os.clock()
		end
		Movement.Knockback(humanoid, root, velocity, tumble)
	end)

	Net.Event("Effect").OnClientEvent:Connect(function(kind, data)
		local handler = handlers[kind]
		if handler and type(data) == "table" then
			local ok, err = pcall(handler, data)
			if not ok then
				warn("[LaunchParty] Effect error:", kind, err)
			end
		end
	end)

	RunService.RenderStepped:Connect(function(dt)
		local _, humanoid = getCharacter()
		if shakeIntensity > 0 then
			shakeIntensity = math.max(0, shakeIntensity - shakeDecay * dt)
			if humanoid then
				humanoid.CameraOffset = random:NextUnitVector() * shakeIntensity * 0.6
			end
		elseif humanoid and humanoid.CameraOffset ~= Vector3.zero then
			humanoid.CameraOffset = Vector3.zero
		end
	end)
end

return EffectsController
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX0000001C">
						<Properties>
							<string name="Name">HUDController</string>
							<ProtectedString name="Source"><![CDATA[-- The whole heads-up display, built in code.
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Cosmetics = require(Shared:WaitForChild("Cosmetics"))
local Net = require(Shared:WaitForChild("Net"))

local State = require(script.Parent.State)
local UI = require(script.Parent.UI)

local HUDController = {}

local player = Players.LocalPlayer
local gameState = Net.GameState()

local gui: ScreenGui
local refs: { [string]: any } = {}
local lastHeat = 0
local announceToken = 0

local STATE_TITLES = {
	Waiting = "WAITING FOR PLAYERS",
	Intermission = "MATCH STARTING",
	Countdown = "GET READY",
	Live = "FIGHT!",
	RoundEnd = "ROUND OVER",
	Draft = "DRAFT PHASE",
	MatchEnd = "MATCH OVER",
}

-- Construction ------------------------------------------------------------------------------

local function buildTopBar()
	local bar = UI.new("Frame", {
		Name = "TopBar",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.new(0.6, 0, 0, 66),
		BackgroundColor3 = UI.Panel,
		BackgroundTransparency = 0.2,
		Parent = gui,
	}, { UI.corner(14), UI.stroke(Color3.fromRGB(255, 205, 60), 2, 0.3) })
	UI.new("UISizeConstraint", { MinSize = Vector2.new(300, 66), MaxSize = Vector2.new(480, 66), Parent = bar })

	refs.StateLabel = UI.label({
		Name = "State",
		Position = UDim2.new(0, 16, 0, 6),
		Size = UDim2.new(0.72, -16, 0, 30),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(255, 210, 70),
		Text = "LAUNCH PARTY",
		Parent = bar,
	})
	refs.InfoLabel = UI.label({
		Name = "Info",
		Position = UDim2.new(0, 16, 0, 38),
		Size = UDim2.new(0.72, -16, 0, 20),
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = UI.BodyFont,
		TextColor3 = Color3.fromRGB(220, 225, 240),
		Text = "",
		Parent = bar,
	})
	refs.TimerLabel = UI.label({
		Name = "Timer",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -16, 0.5, 0),
		Size = UDim2.new(0.26, 0, 0, 44),
		TextXAlignment = Enum.TextXAlignment.Right,
		Text = "",
		Parent = bar,
	})
end

local function buildHeatPanel()
	local panel = UI.new("Frame", {
		Name = "HeatPanel",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -18),
		Size = UDim2.new(0, 260, 0, 120),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	refs.HeatLabel = UI.label({
		Name = "Heat",
		Size = UDim2.new(1, 0, 0, 70),
		Text = "0%",
		Parent = panel,
	})
	UI.textStroke(3).Parent = refs.HeatLabel
	UI.label({
		Name = "Caption",
		Position = UDim2.new(0, 0, 0, 66),
		Size = UDim2.new(1, 0, 0, 16),
		Font = UI.BodyFont,
		TextColor3 = Color3.fromRGB(210, 215, 230),
		Text = "HEAT",
		Parent = panel,
	})

	local pips = UI.new("Frame", {
		Name = "DashPips",
		Position = UDim2.new(0.5, 0, 0, 88),
		AnchorPoint = Vector2.new(0.5, 0),
		Size = UDim2.new(1, 0, 0, 10),
		BackgroundTransparency = 1,
		Parent = panel,
	}, {
		UI.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 6),
		}),
	})
	refs.DashPips = pips

	local chargeBack = UI.new("Frame", {
		Name = "Charge",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 104),
		Size = UDim2.new(0.8, 0, 0, 10),
		BackgroundColor3 = Color3.fromRGB(30, 30, 40),
		BackgroundTransparency = 0.2,
		Visible = false,
		Parent = panel,
	}, { UI.corner(5) })
	refs.ChargeBack = chargeBack
	refs.ChargeFill = UI.new("Frame", {
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = Color3.fromRGB(255, 170, 50),
		Parent = chargeBack,
	}, { UI.corner(5) })

	refs.ComboLabel = UI.label({
		Name = "Combo",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 0, -6),
		Size = UDim2.new(1, 0, 0, 34),
		TextColor3 = Color3.fromRGB(255, 220, 90),
		Text = "",
		Visible = false,
		Parent = panel,
	})
	UI.textStroke(2).Parent = refs.ComboLabel
end

local function buildScoreboard()
	local board = UI.new("Frame", {
		Name = "Scoreboard",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 90),
		Size = UDim2.new(0, 230, 0, 30),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = UI.Panel,
		BackgroundTransparency = 0.3,
		Parent = gui,
	}, {
		UI.corner(12),
		UI.new("UIPadding", {
			PaddingTop = UDim.new(0, 8),
			PaddingBottom = UDim.new(0, 8),
			PaddingLeft = UDim.new(0, 10),
			PaddingRight = UDim.new(0, 10),
		}),
		UI.new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 3) }),
	})
	UI.label({
		Name = "Title",
		LayoutOrder = 0,
		Size = UDim2.new(1, 0, 0, 20),
		TextColor3 = Color3.fromRGB(255, 210, 70),
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "SCORES",
		Parent = board,
	})
	refs.Scoreboard = board
end

local function buildKillFeed()
	refs.KillFeed = UI.new("Frame", {
		Name = "KillFeed",
		Position = UDim2.new(0, 12, 0, 90),
		Size = UDim2.new(0, 320, 0, 200),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		UI.new("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 4),
		}),
	})
end

local function buildAnnouncement()
	refs.Announce = UI.label({
		Name = "Announce",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.32, 0),
		Size = UDim2.new(0.8, 0, 0, 96),
		Text = "",
		Visible = false,
		Parent = gui,
	})
	UI.new("UISizeConstraint", { MaxSize = Vector2.new(900, 96), Parent = refs.Announce })
	UI.textStroke(4).Parent = refs.Announce
	refs.AnnounceSub = UI.label({
		Name = "AnnounceSub",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.32, 52),
		Size = UDim2.new(0.7, 0, 0, 30),
		Font = UI.BodyFont,
		Text = "",
		Visible = false,
		Parent = gui,
	})
	UI.new("UISizeConstraint", { MaxSize = Vector2.new(760, 30), Parent = refs.AnnounceSub })
	UI.textStroke(2).Parent = refs.AnnounceSub
end

local function buildProfile()
	local panel = UI.new("Frame", {
		Name = "Profile",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 12, 1, -12),
		Size = UDim2.new(0, 220, 0, 52),
		BackgroundColor3 = UI.Panel,
		BackgroundTransparency = 0.3,
		Parent = gui,
	}, { UI.corner(12) })
	refs.LevelLabel = UI.label({
		Position = UDim2.new(0, 10, 0, 6),
		Size = UDim2.new(1, -20, 0, 22),
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "LV 1 · Rookie",
		Parent = panel,
	})
	local barBack = UI.new("Frame", {
		Position = UDim2.new(0, 10, 0, 34),
		Size = UDim2.new(1, -20, 0, 8),
		BackgroundColor3 = Color3.fromRGB(45, 48, 66),
		Parent = panel,
	}, { UI.corner(4) })
	refs.XPFill = UI.new("Frame", {
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = Color3.fromRGB(140, 255, 90),
		Parent = barBack,
	}, { UI.corner(4) })

	local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	refs.Controls = UI.label({
		Name = "Controls",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 12, 1, -70),
		Size = UDim2.new(0, 300, 0, 18),
		Font = UI.BodyFont,
		TextColor3 = Color3.fromRGB(200, 205, 220),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTransparency = 0.2,
		Text = if touch then "PUNCH: tap/hold · DASH: button" else "CLICK punch · HOLD charge · Q/SHIFT dash",
		Parent = gui,
	})
end

-- Updates -------------------------------------------------------------------------------------

local function refreshProfile()
	local level = player:GetAttribute("Level") or 1
	local title = player:GetAttribute("Title") or "Rookie"
	local into = player:GetAttribute("XPInto") or 0
	local needed = player:GetAttribute("XPNeeded") or 100
	refs.LevelLabel.Text = string.format("LV %d · %s", level, title)
	UI.tween(refs.XPFill, 0.4, { Size = UDim2.new(math.clamp(into / math.max(needed, 1), 0, 1), 0, 1, 0) })
end

local function refreshScoreboard()
	local board = refs.Scoreboard
	for _, child in board:GetChildren() do
		if child:IsA("TextLabel") and child.Name == "Row" then
			child:Destroy()
		end
	end
	local raw = gameState:GetAttribute("Scoreboard")
	local ok, rows = pcall(function()
		return HttpService:JSONDecode(raw or "[]")
	end)
	if not ok or type(rows) ~= "table" or #rows == 0 then
		board.Visible = false
		return
	end
	board.Visible = true
	local myId = State.MyId()
	for index, row in rows do
		local crown = if row.Crown then "👑 " else ""
		local name = tostring(row.Name)
		if #name > 14 then
			name = string.sub(name, 1, 13) .. "…"
		end
		local label = UI.label({
			Name = "Row",
			LayoutOrder = index,
			Size = UDim2.new(1, 0, 0, 20),
			Font = UI.BodyFont,
			TextXAlignment = Enum.TextXAlignment.Left,
			RichText = true,
			TextColor3 = if row.Id == myId
				then Color3.fromRGB(120, 230, 255)
				elseif row.Alive then Color3.new(1, 1, 1)
				else Color3.fromRGB(140, 145, 160),
			Text = string.format('%s%s<font color="#FFD24A">  %d pts</font>  <font color="#9AA0B4">%d KO</font>', crown, name, row.Points or 0, row.KOs or 0),
			Parent = board,
		})
		label.TextScaled = true
	end
end

local function refreshState()
	local stateName = gameState:GetAttribute("State") or "Waiting"
	local round = gameState:GetAttribute("Round") or 0
	local maxRounds = gameState:GetAttribute("MaxRounds") or Config.Match.RoundsPerMatch
	local eventName = gameState:GetAttribute("Event") or ""
	local arenaName = gameState:GetAttribute("Arena") or ""

	if (stateName == "Live" or stateName == "Countdown" or stateName == "RoundEnd") and round > 0 then
		local suffix = if gameState:GetAttribute("SuddenDeath") then " · SUDDEN DEATH" else ""
		refs.StateLabel.Text = string.format("ROUND %d / %d%s", round, maxRounds, suffix)
		refs.InfoLabel.Text = string.format("%s · %s", eventName, arenaName)
	elseif stateName == "Draft" then
		refs.StateLabel.Text = STATE_TITLES.Draft
		refs.InfoLabel.Text = string.format("Next: round %d of %d", round + 1, maxRounds)
	elseif stateName == "MatchEnd" then
		refs.StateLabel.Text = STATE_TITLES.MatchEnd
		refs.InfoLabel.Text = "Champion: " .. tostring(gameState:GetAttribute("Champion") or "?")
	else
		refs.StateLabel.Text = STATE_TITLES[stateName] or stateName
		refs.InfoLabel.Text = if stateName == "Waiting"
			then "Punch the dummies while you wait!"
			else "Bots fill empty slots. Get comfy in the lobby."
	end
end

local function updateDashPips()
	local charges = player:GetAttribute("DashCharges") or 1
	local pips = refs.DashPips
	local existing = {}
	for _, child in pips:GetChildren() do
		if child:IsA("Frame") then
			table.insert(existing, child)
		end
	end
	while #existing < charges do
		local pip = UI.new("Frame", {
			Size = UDim2.new(0, 34, 0, 8),
			BackgroundColor3 = Color3.fromRGB(90, 220, 255),
			Parent = pips,
		}, { UI.corner(4) })
		table.insert(existing, pip)
	end
	while #existing > charges do
		table.remove(existing):Destroy()
	end
	local now = os.clock()
	for index, pip in existing do
		local ready = (State.DashReady[index] or 0) <= now
		pip.BackgroundColor3 = if ready then Color3.fromRGB(90, 220, 255) else Color3.fromRGB(60, 64, 84)
	end
end

local function renderStep()
	-- Timer
	local endsAt = gameState:GetAttribute("EndsAt") or 0
	if endsAt > 0 then
		local remaining = endsAt - Workspace:GetServerTimeNow()
		refs.TimerLabel.Text = UI.formatTime(remaining)
		local live = gameState:GetAttribute("State") == "Live"
		refs.TimerLabel.TextColor3 = if live and remaining <= 10 then Color3.fromRGB(255, 90, 80) else Color3.new(1, 1, 1)
	else
		refs.TimerLabel.Text = ""
	end

	-- Heat
	local character = player.Character
	local heat = if character then character:GetAttribute("Heat") or 0 else 0
	refs.HeatLabel.Text = string.format("%d%%", math.floor(heat))
	refs.HeatLabel.TextColor3 = Cosmetics.HeatColor(heat)
	if heat > lastHeat + 0.5 then
		UI.pop(refs.HeatLabel, 1.25 + math.min((heat - lastHeat) / 40, 0.5), 0.3)
	end
	lastHeat = heat

	-- Charge bar
	if State.Charging then
		local chargeSpeed = player:GetAttribute("ChargeSpeed") or 1
		local alpha = math.clamp((os.clock() - State.ChargeStart) * chargeSpeed / Config.Combat.ChargeMaxTime, 0, 1)
		refs.ChargeBack.Visible = true
		refs.ChargeFill.Size = UDim2.new(alpha, 0, 1, 0)
		refs.ChargeFill.BackgroundColor3 = if alpha >= 1
			then Color3.fromRGB(255, 70, 50)
			elseif alpha >= Config.Combat.ChargeThreshold then Color3.fromRGB(255, 170, 50)
			else Color3.fromRGB(200, 200, 210)
	else
		refs.ChargeBack.Visible = false
	end

	updateDashPips()

	if refs.ComboLabel.Visible and os.clock() - State.LastComboHit > 1.6 then
		refs.ComboLabel.Visible = false
	end
end

-- Messages -------------------------------------------------------------------------------------

function HUDController.Announce(text: string, style: string?, subtitle: string?)
	announceToken += 1
	local token = announceToken
	local label, sub = refs.Announce, refs.AnnounceSub
	style = style or "Big"

	label.Text = text
	label.Visible = true
	label.TextTransparency = 0
	label.Size = UDim2.new(0.8, 0, 0, if style == "Small" then 56 elseif style == "Count" then 120 else 96)
	label.TextColor3 = if style == "Event"
		then Color3.fromRGB(255, 120, 80)
		elseif style == "Count" then Color3.fromRGB(255, 220, 90)
		else Color3.new(1, 1, 1)
	UI.pop(label, if style == "Count" then 1.8 else 1.4, 0.3)

	sub.Text = subtitle or ""
	sub.Visible = subtitle ~= nil and subtitle ~= ""
	sub.TextTransparency = 0

	local hold = if style == "Count" then 0.75 elseif style == "Small" then 1.6 else 2.2
	task.delay(hold, function()
		if token ~= announceToken then
			return
		end
		UI.tween(label, 0.3, { TextTransparency = 1 })
		UI.tween(sub, 0.3, { TextTransparency = 1 })
		task.wait(0.3)
		if token == announceToken then
			label.Visible = false
			sub.Visible = false
		end
	end)
end

local feedCount = 0
function HUDController.Feed(text: string, color: Color3?)
	feedCount += 1
	local entry = UI.label({
		LayoutOrder = feedCount,
		Size = UDim2.new(1, 0, 0, 24),
		Font = UI.BodyFont,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = color or Color3.new(1, 1, 1),
		BackgroundColor3 = UI.Panel,
		BackgroundTransparency = 0.35,
		Text = "  " .. text,
		Parent = refs.KillFeed,
	})
	UI.corner(8).Parent = entry
	UI.pop(entry, 1.15, 0.2)
	local entries = {}
	for _, child in refs.KillFeed:GetChildren() do
		if child:IsA("TextLabel") then
			table.insert(entries, child)
		end
	end
	table.sort(entries, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	while #entries > 6 do
		table.remove(entries, 1):Destroy()
	end
	task.delay(6, function()
		if entry.Parent then
			UI.tween(entry, 0.4, { TextTransparency = 1, BackgroundTransparency = 1 })
			task.wait(0.4)
			entry:Destroy()
		end
	end)
end

local function onKillFeed(data)
	if type(data) ~= "table" then
		return
	end
	if data.Text then
		HUDController.Feed(tostring(data.Text), Color3.fromRGB(255, 220, 120))
		return
	end
	local myId = State.MyId()
	local victim = tostring(data.Victim)
	if data.Killer then
		local killer = tostring(data.Killer)
		local bounty = if data.Bounty then "  👑 BOUNTY!" else ""
		HUDController.Feed(string.format("💥 %s launched %s%s", killer, victim, bounty))
		if data.KillerId == myId then
			HUDController.Announce("KO!", "Big", if data.Bounty then "Bounty claimed! +1 bonus point" else "Launched " .. victim)
		end
	else
		HUDController.Feed(string.format("🕳️ %s fell into the void", victim), Color3.fromRGB(200, 205, 220))
	end
	if data.VictimId == myId then
		HUDController.Announce("LAUNCHED!", "Event", if data.Killer then "by " .. tostring(data.Killer) else "Watch your step...")
	end
end

-- Match results ---------------------------------------------------------------------------------

local function showResults(data)
	if type(data) ~= "table" then
		return
	end
	if refs.Results then
		refs.Results:Destroy()
	end
	local panel = UI.new("Frame", {
		Name = "Results",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.55, 0),
		Size = UDim2.new(0, 420, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = UI.Panel,
		BackgroundTransparency = 0.08,
		Parent = gui,
	}, {
		UI.corner(16),
		UI.stroke(Color3.fromRGB(255, 205, 60), 3),
		UI.new("UIPadding", {
			PaddingTop = UDim.new(0, 14),
			PaddingBottom = UDim.new(0, 14),
			PaddingLeft = UDim.new(0, 18),
			PaddingRight = UDim.new(0, 18),
		}),
		UI.new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }),
	})
	refs.Results = panel

	local order = 0
	local function line(text: string, height: number, color: Color3?, font: Enum.Font?)
		order += 1
		UI.label({
			LayoutOrder = order,
			Size = UDim2.new(1, 0, 0, height),
			Text = text,
			TextColor3 = color or Color3.new(1, 1, 1),
			Font = font or UI.Font,
			Parent = panel,
		})
	end

	local placement = data.Placement or 0
	local ordinal = ({ "1st", "2nd", "3rd" })[placement] or (tostring(placement) .. "th")
	line(if placement == 1 then "🏆 CHAMPION! 🏆" else "You placed " .. ordinal, 40, Color3.fromRGB(255, 210, 70))
	line(string.format("%d points · %d KOs", data.Points or 0, data.KOs or 0), 22, nil, UI.BodyFont)
	local medals = { "🥇", "🥈", "🥉" }
	for index, entry in data.Podium or {} do
		line(string.format("%s %s — %d pts", medals[index] or "", tostring(entry.Name), entry.Points or 0), 22, nil, UI.BodyFont)
	end

	local rewards = data.Rewards
	if type(rewards) == "table" then
		line(string.format("+%d XP", rewards.XP or 0), 34, Color3.fromRGB(140, 255, 90))
		for _, text in rewards.Breakdown or {} do
			line(tostring(text), 18, Color3.fromRGB(190, 195, 210), UI.BodyFont)
		end
		if (rewards.NewLevel or 0) > (rewards.OldLevel or 0) then
			line(string.format("LEVEL UP!  %d → %d", rewards.OldLevel, rewards.NewLevel), 32, Color3.fromRGB(90, 230, 255))
		end
		for _, unlock in rewards.Unlocks or {} do
			line("🔓 " .. tostring(unlock), 22, Color3.fromRGB(255, 184, 40), UI.BodyFont)
		end
		if rewards.Persistent == false then
			line("(Progress isn't saved in this session)", 16, Color3.fromRGB(160, 160, 170), UI.BodyFont)
		end
	end

	UI.pop(panel, 0.6, 0.4)
	task.delay(Config.Match.MatchEndTime + 1, function()
		if refs.Results == panel then
			panel:Destroy()
			refs.Results = nil
		end
	end)
end

-- Lifecycle -------------------------------------------------------------------------------------

function HUDController.Start()
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
	end)

	gui = UI.new("ScreenGui", {
		Name = "LaunchPartyHUD",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	buildTopBar()
	buildHeatPanel()
	buildScoreboard()
	buildKillFeed()
	buildAnnouncement()
	buildProfile()

	refreshState()
	refreshScoreboard()
	refreshProfile()

	-- Our own heat is on the HUD, so hide the floating tag above our head.
	local function hideOwnTag(character: Model)
		local tag = character:WaitForChild("FighterTag", 15)
		if tag and tag:IsA("BillboardGui") then
			tag.Enabled = false
		end
	end
	player.CharacterAdded:Connect(hideOwnTag)
	if player.Character then
		task.spawn(hideOwnTag, player.Character)
	end

	gameState.AttributeChanged:Connect(function(attribute)
		if attribute == "Scoreboard" then
			refreshScoreboard()
		else
			refreshState()
		end
	end)
	for _, attribute in { "Level", "Title", "XPInto", "XPNeeded" } do
		player:GetAttributeChangedSignal(attribute):Connect(refreshProfile)
	end

	Net.Event("Announce").OnClientEvent:Connect(function(text, style, subtitle)
		if type(text) == "string" then
			HUDController.Announce(text, style, subtitle)
		end
	end)
	Net.Event("KillFeed").OnClientEvent:Connect(onKillFeed)
	Net.Event("MatchResults").OnClientEvent:Connect(showResults)

	State.BigMessage.Event:Connect(function(text, style, subtitle)
		HUDController.Announce(text, style, subtitle)
	end)
	State.ComboChanged.Event:Connect(function(combo)
		if combo >= 2 then
			refs.ComboLabel.Text = string.format("x%d COMBO!", combo)
			refs.ComboLabel.Visible = true
			UI.pop(refs.ComboLabel, 1.5, 0.25)
		end
	end)

	RunService.RenderStepped:Connect(function()
		local ok, err = pcall(renderStep)
		if not ok then
			warn("[LaunchParty] HUD error:", err)
		end
	end)
end

return HUDController
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX0000001D">
						<Properties>
							<string name="Name">InputController</string>
							<ProtectedString name="Source"><![CDATA[-- Input: punch (tap) / charged punch (hold) / dash. Animations, sounds and dash movement are
-- predicted locally for instant feel; the server independently validates and resolves hits.
local CollectionService = game:GetService("CollectionService")
local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Movement = require(Shared:WaitForChild("Movement"))
local Net = require(Shared:WaitForChild("Net"))

local EffectsController = require(script.Parent.EffectsController)
local State = require(script.Parent.State)

local InputController = {}

local C = Config.Combat
local player = Players.LocalPlayer
local chargeRemote = Net.Event("ChargeStart")
local punchRemote = Net.Event("Punch")
local dashRemote = Net.Event("Dash")

local tracks: { [string]: AnimationTrack } = {}

local function getCharacter(): (Model?, Humanoid?, BasePart?)
	local character = player.Character
	if not character then
		return nil, nil, nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not humanoid or not root or humanoid.Health <= 0 then
		return nil, nil, nil
	end
	return character, humanoid, root
end

local function loadTracks(character: Model)
	table.clear(tracks)
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	if not humanoid then
		return
	end
	local animator = humanoid:WaitForChild("Animator", 10) :: Animator?
	if not animator then
		return
	end
	for _, key in { "Punch", "Charged" } do
		local animation = Instance.new("Animation")
		animation.AnimationId = Config.Anims[key]
		local ok, track = pcall(function()
			return animator:LoadAnimation(animation)
		end)
		if ok and track then
			track.Priority = Enum.AnimationPriority.Action
			tracks[key] = track
		end
	end
end

local function playTrack(key: string)
	local track = tracks[key]
	if track then
		track:Play(0.05)
		track:AdjustSpeed(1.6)
	end
end

local function flatten(vector: Vector3, fallback: Vector3): Vector3
	local flat = Vector3.new(vector.X, 0, vector.Z)
	if flat.Magnitude > 0.05 then
		return flat.Unit
	end
	local flatFallback = Vector3.new(fallback.X, 0, fallback.Z)
	if flatFallback.Magnitude > 0.05 then
		return flatFallback.Unit
	end
	return Vector3.new(0, 0, -1)
end

-- Camera-forward aim with gentle aim assist toward the most "in front" nearby fighter.
local function aimDirection(root: BasePart): Vector3
	local camera = Workspace.CurrentCamera
	local look = flatten(if camera then camera.CFrame.LookVector else root.CFrame.LookVector, root.CFrame.LookVector)
	local best, bestScore = nil, -math.huge
	for _, model in CollectionService:GetTagged("Fighter") do
		if model ~= player.Character and model:IsA("Model") then
			local otherRoot = model:FindFirstChild("HumanoidRootPart") :: BasePart?
			if otherRoot then
				local offset = otherRoot.Position - root.Position
				local flat = Vector3.new(offset.X, 0, offset.Z)
				local distance = flat.Magnitude
				if distance > 0.1 and distance < 11 and math.abs(offset.Y) < 7 then
					local dot = flat.Unit:Dot(look)
					if dot > 0.45 then
						local score = dot * 2 - distance / 11
						if score > bestScore then
							best, bestScore = flat.Unit, score
						end
					end
				end
			end
		end
	end
	return best or look
end

local function isFrozen(humanoid: Humanoid): boolean
	return humanoid.WalkSpeed <= 0.01 and humanoid.JumpPower <= 0.01
end

function InputController.BeginCharge()
	local _, humanoid, _ = getCharacter()
	if not humanoid or State.Charging or isFrozen(humanoid) or Movement.IsTumbling(humanoid) then
		return
	end
	local cooldown = player:GetAttribute("PunchCooldown") or C.PunchCooldown
	if os.clock() - State.LastPunch < cooldown then
		return
	end
	State.Charging = true
	State.ChargeStart = os.clock()
	chargeRemote:FireServer()
end

function InputController.ReleasePunch()
	if not State.Charging then
		return
	end
	State.Charging = false
	local _, humanoid, root = getCharacter()
	if not humanoid or not root then
		return
	end
	local chargeSpeed = player:GetAttribute("ChargeSpeed") or 1
	local alpha = math.clamp((os.clock() - State.ChargeStart) * chargeSpeed / C.ChargeMaxTime, 0, 1)
	local charged = alpha >= C.ChargeThreshold
	local aim = aimDirection(root)
	if not Movement.IsTumbling(humanoid) then
		root.CFrame = CFrame.lookAt(root.Position, root.Position + aim)
	end
	State.LastPunch = os.clock()
	playTrack(if charged then "Charged" else "Punch")
	EffectsController.PlaySound(if charged then Config.Sounds.ChargedSwing else Config.Sounds.Swing, nil, 0.45)
	punchRemote:FireServer(aim)
end

function InputController.Dash()
	local _, humanoid, root = getCharacter()
	if not humanoid or not root or isFrozen(humanoid) then
		return
	end
	local now = os.clock()
	if now - State.LastKnockback < C.HitstunDashLock then
		return
	end

	local charges = player:GetAttribute("DashCharges") or 1
	while #State.DashReady < charges do
		table.insert(State.DashReady, 0)
	end
	while #State.DashReady > charges do
		table.remove(State.DashReady)
	end
	local slot = nil
	for index, readyAt in State.DashReady do
		if readyAt <= now then
			slot = index
			break
		end
	end
	if not slot then
		return
	end
	State.DashReady[slot] = now + (player:GetAttribute("DashCooldown") or C.DashCooldown)

	local direction = if humanoid.MoveDirection.Magnitude > 0.1
		then flatten(humanoid.MoveDirection, root.CFrame.LookVector)
		else aimDirection(root)
	State.Charging = false
	Movement.Dash(humanoid, root, direction, C)
	dashRemote:FireServer(direction)
	EffectsController.PlaySound(Config.Sounds.Dash, nil, 0.5, 1.3)
	EffectsController.FovKick(5)
end

function InputController.Start()
	player.CharacterAdded:Connect(function(character)
		State.Charging = false
		table.clear(State.DashReady)
		loadTracks(character)
	end)
	if player.Character then
		task.spawn(loadTracks, player.Character)
	end

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			InputController.BeginCharge()
		elseif input.KeyCode == Enum.KeyCode.Q or input.KeyCode == Enum.KeyCode.LeftShift then
			InputController.Dash()
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			InputController.ReleasePunch()
		end
	end)

	-- Touch buttons + gamepad.
	ContextActionService:BindAction("LP_Punch", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			InputController.BeginCharge()
		elseif inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel then
			InputController.ReleasePunch()
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.KeyCode.ButtonR2)
	ContextActionService:SetTitle("LP_Punch", "PUNCH")
	ContextActionService:SetPosition("LP_Punch", UDim2.new(1, -200, 1, -110))

	ContextActionService:BindAction("LP_Dash", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			InputController.Dash()
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.KeyCode.ButtonX, Enum.KeyCode.ButtonL2)
	ContextActionService:SetTitle("LP_Dash", "DASH")
	ContextActionService:SetPosition("LP_Dash", UDim2.new(1, -150, 1, -190))
end

return InputController
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX0000001E">
						<Properties>
							<string name="Name">State</string>
							<ProtectedString name="Source"><![CDATA[-- Tiny shared client state so controllers can talk without depending on each other.
local comboChanged = Instance.new("BindableEvent")
local bigMessage = Instance.new("BindableEvent")

local State = {
	Charging = false,
	ChargeStart = 0,
	LastPunch = -math.huge,
	LastKnockback = -math.huge,
	DashReady = { 0 },
	Combo = 0,
	LastComboHit = 0,
	ComboChanged = comboChanged,
	-- Fire(text, style, subtitle) to show a local-only announcement.
	BigMessage = bigMessage,
}

function State.MyId(): string
	return "P" .. game:GetService("Players").LocalPlayer.UserId
end

return State
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX0000001F">
						<Properties>
							<string name="Name">UI</string>
							<ProtectedString name="Source"><![CDATA[-- Small helpers for building GUIs in code.
local TweenService = game:GetService("TweenService")

local UI = {}

UI.Font = Enum.Font.FredokaOne
UI.BodyFont = Enum.Font.GothamBold
UI.Panel = Color3.fromRGB(22, 24, 38)

function UI.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local instance = Instance.new(className)
	local parent = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				(instance :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function UI.corner(radius: number?): UICorner
	return UI.new("UICorner", { CornerRadius = UDim.new(0, radius or 10) })
end

function UI.stroke(color: Color3?, thickness: number?, transparency: number?): UIStroke
	return UI.new("UIStroke", {
		Color = color or Color3.new(0, 0, 0),
		Thickness = thickness or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function UI.textStroke(thickness: number?): UIStroke
	return UI.new("UIStroke", {
		Color = Color3.new(0, 0, 0),
		Thickness = thickness or 2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
	})
end

function UI.label(props: { [string]: any }): TextLabel
	local defaults = {
		BackgroundTransparency = 1,
		Font = UI.Font,
		TextColor3 = Color3.new(1, 1, 1),
		TextScaled = true,
	}
	for key, value in props do
		defaults[key] = value
	end
	return UI.new("TextLabel", defaults)
end

-- Quick "pop" scale animation using a UIScale child.
function UI.pop(guiObject: GuiObject, from: number?, duration: number?)
	local scale = guiObject:FindFirstChildOfClass("UIScale")
	if not scale then
		scale = UI.new("UIScale", { Parent = guiObject })
	end
	scale.Scale = from or 1.35
	TweenService:Create(scale, TweenInfo.new(duration or 0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Scale = 1,
	}):Play()
end

function UI.tween(instance: Instance, duration: number, goals: { [string]: any }, style: Enum.EasingStyle?, direction: Enum.EasingDirection?): Tween
	local tween = TweenService:Create(
		instance,
		TweenInfo.new(duration, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out),
		goals
	)
	tween:Play()
	return tween
end

function UI.formatTime(seconds: number): string
	seconds = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

return UI
]]></ProtectedString>
						</Properties>
					</Item>
				</Item>
			</Item>
		</Item>
	</Item>
</roblox>
