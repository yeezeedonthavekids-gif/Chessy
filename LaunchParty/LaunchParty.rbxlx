				<Item class="ModuleScript" referent="RBX0000000F">
					<Properties>
						<string name="Name">BotService</string>
						<ProtectedString name="Source"><![CDATA[-- Bots keep matches lively when the server is quiet, and dummies give the lobby something to punch.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)

local ArenaService = require(script.Parent.ArenaService)
local CombatService = require(script.Parent.CombatService)
local FighterService = require(script.Parent.FighterService)

type Fighter = FighterService.Fighter

local BotService = {}

local BOT_NAMES = {
	"Gary", "Bonkers", "Sir Yeetsalot", "Noodle", "Captain Wobble", "Meatball", "Turbo Toast",
	"Lil' Launch", "Big Steve", "Pudding", "Chonk", "Wiggles", "Doomba", "Mr. Bounce", "Kevin",
}

local PALETTES = {
	{ Color3.fromRGB(255, 120, 90), Color3.fromRGB(60, 70, 160) },
	{ Color3.fromRGB(90, 200, 255), Color3.fromRGB(40, 40, 60) },
	{ Color3.fromRGB(255, 210, 70), Color3.fromRGB(200, 60, 60) },
	{ Color3.fromRGB(150, 255, 120), Color3.fromRGB(70, 50, 120) },
	{ Color3.fromRGB(230, 120, 255), Color3.fromRGB(30, 120, 90) },
	{ Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 90, 160) },
}
local SKIN = Color3.fromRGB(255, 214, 170)

local rng = Random.new()
local nextBotId = 0
local bots: { Fighter } = {}
local fighterFolder: Folder? = nil

local function getFolder(): Folder
	if fighterFolder and fighterFolder.Parent then
		return fighterFolder
	end
	local folder = Instance.new("Folder")
	folder.Name = "Bots"
	folder.Parent = Workspace
	fighterFolder = folder
	return folder
end

local function pickName(): string
	local used = {}
	for _, bot in bots do
		used[bot.Name] = true
	end
	local options = {}
	for _, name in BOT_NAMES do
		if not used[name] then
			table.insert(options, name)
		end
	end
	if #options == 0 then
		return "Bot " .. tostring(nextBotId)
	end
	return options[rng:NextInteger(1, #options)]
end

-- A minimal rig in case avatar loading fails (e.g. offline Studio). Not pretty, but playable.
local function buildFallbackRig(shirt: Color3, pants: Color3): Model
	local model = Instance.new("Model")
	local function piece(name: string, size: Vector3, offset: Vector3, color: Color3, transparency: number?): Part
		local part = Instance.new("Part")
		part.Name = name
		part.Size = size
		part.Color = color
		part.Transparency = transparency or 0
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		part.CFrame = CFrame.new(offset)
		part.Parent = model
		return part
	end
	local root = piece("HumanoidRootPart", Vector3.new(2, 2, 1), Vector3.new(0, 0, 0), shirt, 1)
	local parts = {
		piece("UpperTorso", Vector3.new(2, 2, 1), Vector3.new(0, 0, 0), shirt),
		piece("Head", Vector3.new(1.2, 1.2, 1.2), Vector3.new(0, 1.6, 0), SKIN),
		piece("LeftLeg", Vector3.new(0.9, 2, 1), Vector3.new(-0.5, -2, 0), pants),
		piece("RightLeg", Vector3.new(0.9, 2, 1), Vector3.new(0.5, -2, 0), pants),
		piece("LeftArm", Vector3.new(0.8, 2, 0.8), Vector3.new(-1.4, 0, 0), SKIN),
		piece("RightArm", Vector3.new(0.8, 2, 0.8), Vector3.new(1.4, 0, 0), SKIN),
	}
	for _, part in parts do
		part.CanCollide = part.Name == "UpperTorso" or part.Name == "Head"
		part.Massless = true
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = part
		weld.Parent = part
	end
	local humanoid = Instance.new("Humanoid")
	humanoid.RigType = Enum.HumanoidRigType.R15
	humanoid.HipHeight = 2
	humanoid.Parent = model
	model.PrimaryPart = root
	return model
end

local function buildRig(shirt: Color3, pants: Color3): Model
	local description = Instance.new("HumanoidDescription")
	description.HeadColor = SKIN
	description.LeftArmColor = SKIN
	description.RightArmColor = SKIN
	description.TorsoColor = shirt
	description.LeftLegColor = pants
	description.RightLegColor = pants

	local ok, result = pcall(function()
		return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
	end)
	if ok and result then
		for _, child in result:GetDescendants() do
			if child:IsA("BaseScript") then
				child:Destroy()
			end
		end
		return result
	end
	warn("[LaunchParty] Avatar rig failed, using fallback rig:", result)
	return buildFallbackRig(shirt, pants)
end

local function setupAnimations(fighter: Fighter)
	local humanoid = fighter.Humanoid :: Humanoid
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		local created = Instance.new("Animator")
		created.Parent = humanoid
		animator = created
	end

	local tracks: { [string]: AnimationTrack } = {}
	for key, id in Config.Anims do
		local animation = Instance.new("Animation")
		animation.AnimationId = id
		local ok, track = pcall(function()
			return (animator :: Animator):LoadAnimation(animation)
		end)
		if ok and track then
			tracks[key] = track
		end
	end
	if tracks.Idle then
		tracks.Idle.Looped = true
		tracks.Idle.Priority = Enum.AnimationPriority.Idle
		tracks.Idle:Play()
	end
	if tracks.Walk then
		tracks.Walk.Looped = true
		tracks.Walk.Priority = Enum.AnimationPriority.Movement
	end
	for _, key in { "Punch", "Charged" } do
		if tracks[key] then
			tracks[key].Priority = Enum.AnimationPriority.Action
		end
	end

	fighter.AnimPlayer = function(kind: string)
		local track = tracks[kind]
		if track then
			track:Play(0.05)
			track:AdjustSpeed(1.6)
		end
	end
	fighter.Brain = fighter.Brain or {}
	fighter.Brain.Tracks = tracks
end

-- Lifecycle ------------------------------------------------------------------------

function BotService.CreateBot(): Fighter
	nextBotId += 1
	local fighter = FighterService.New("B" .. nextBotId, pickName(), { IsBot = true })
	local palette = PALETTES[rng:NextInteger(1, #PALETTES)]
	fighter.Brain = {
		Shirt = palette[1],
		Pants = palette[2],
		Skill = rng:NextNumber(0.35, 0.85),
		Target = nil,
		NextRetarget = 0,
		NextAttack = 0,
		ChargeRelease = nil,
		Tracks = {},
	}
	table.insert(bots, fighter)
	return fighter
end

function BotService.SpawnModel(fighter: Fighter, cframe: CFrame): boolean
	BotService.DespawnModel(fighter)
	local brain = fighter.Brain
	local model = buildRig(brain.Shirt, brain.Pants)
	model.Name = fighter.Name
	model:PivotTo(cframe)
	model.Parent = getFolder()

	if not FighterService.BindModel(fighter, model) then
		model:Destroy()
		return false
	end
	local root = fighter.Root :: BasePart
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	setupAnimations(fighter)
	return true
end

function BotService.DespawnModel(fighter: Fighter)
	local model = fighter.Model
	FighterService.UnbindModel(fighter)
	if model then
		model:Destroy()
	end
end

function BotService.Remove(fighter: Fighter)
	BotService.DespawnModel(fighter)
	FighterService.Remove(fighter)
	local index = table.find(bots, fighter)
	if index then
		table.remove(bots, index)
	end
end

function BotService.CreateDummy(home: CFrame): Fighter
	nextBotId += 1
	local fighter = FighterService.New("D" .. nextBotId, "Practice Dummy", { IsBot = true, IsDummy = true })
	fighter.Brain = { Shirt = Color3.fromRGB(230, 170, 90), Pants = Color3.fromRGB(150, 100, 60), Skill = 0, Tracks = {} }
	fighter.Home = home
	fighter.Zone = "Lobby"
	BotService.SpawnModel(fighter, home)
	table.insert(bots, fighter)
	return fighter
end

-- AI -------------------------------------------------------------------------------

local function flat(vector: Vector3): Vector3
	return Vector3.new(vector.X, 0, vector.Z)
end

local function safeUnit(vector: Vector3, fallback: Vector3): Vector3
	if vector.Magnitude > 0.05 then
		return vector.Unit
	end
	return fallback
end

local function chooseTarget(fighter: Fighter, candidates: { Fighter }): Fighter?
	local root = fighter.Root :: BasePart
	local best, bestScore = nil, math.huge
	for _, other in candidates do
		if other ~= fighter then
			local distance = flat((other.Root :: BasePart).Position - root.Position).Magnitude
			-- Prefer close, high-heat targets, and gang up on the crowned leader.
			local score = distance - other.Heat * 0.1 - (if other.Crowned then 12 else 0)
			if score < bestScore then
				best, bestScore = other, score
			end
		end
	end
	return best
end

local function updateWalkAnimation(fighter: Fighter)
	local tracks = fighter.Brain and fighter.Brain.Tracks
	local walk = tracks and tracks.Walk
	if not walk then
		return
	end
	local humanoid = fighter.Humanoid :: Humanoid
	local speed = flat((fighter.Root :: BasePart).AssemblyLinearVelocity).Magnitude
	local moving = speed > 1.5 and not humanoid.PlatformStand
	if moving and not walk.IsPlaying then
		walk:Play(0.15)
	elseif not moving and walk.IsPlaying then
		walk:Stop(0.2)
	end
	if moving then
		walk:AdjustSpeed(math.clamp(speed / 14, 0.6, 1.8))
	end
end

local function thinkDummy(fighter: Fighter, now: number)
	local home = fighter.Home :: CFrame
	if not FighterService.IsAlive(fighter) then
		BotService.SpawnModel(fighter, home)
		return
	end
	local root = fighter.Root :: BasePart
	local away = (root.Position - home.Position).Magnitude
	local idle = now - fighter.LastHitTime > 4 and now > fighter.TumbleUntil
	if root.Position.Y < ArenaService.GetLobbyVoidY() or away > 40 or (idle and away > 3) then
		FighterService.Teleport(fighter, home)
	end
end

local function think(fighter: Fighter, now: number)
	local humanoid = fighter.Humanoid :: Humanoid
	local root = fighter.Root :: BasePart
	local brain = fighter.Brain
	local skill = brain.Skill
	local center = ArenaService.GetCenter()
	local position = root.Position
	local toCenter = safeUnit(flat(center - position), Vector3.new(0, 0, 1))
	local overArena = ArenaService.IsOverArena(position)

	-- Recovery: launched off the edge? Air-dash back toward the middle.
	if not overArena and position.Y < center.Y + 1 then
		if rng:NextNumber() < 0.25 + skill * 0.6 then
			CombatService.TryDash(fighter, toCenter)
		end
		humanoid:Move(toCenter, false)
		return
	end
	if now < fighter.TumbleUntil or humanoid.PlatformStand then
		return
	end

	if now >= brain.NextRetarget or not brain.Target or not brain.Target.Alive then
		brain.Target = chooseTarget(fighter, FighterService.AliveInArena())
		brain.NextRetarget = now + rng:NextNumber(0.8, 1.6)
	end
	local target: Fighter? = brain.Target
	if not target or not FighterService.IsAlive(target) then
		humanoid:Move(toCenter * 0.5, false)
		return
	end

	local offset = flat((target.Root :: BasePart).Position - position)
	local distance = offset.Magnitude
	local aim = safeUnit(offset, root.CFrame.LookVector)
	-- Imperfect aim so bots feel human.
	local wobble = (1 - skill) * 0.35
	aim = safeUnit(aim + Vector3.new(rng:NextNumber(-wobble, wobble), 0, rng:NextNumber(-wobble, wobble)), aim)

	-- Edge avoidance: never walk somewhere with no floor.
	local moveDir = aim
	if not ArenaService.IsOverArena(position + moveDir * 5) then
		moveDir = toCenter
	end

	if brain.ChargeRelease then
		humanoid:Move(moveDir * 0.6, false)
		if now >= brain.ChargeRelease or (distance <= Config.Combat.PunchRange and now >= brain.ChargeRelease - 0.3) then
			root.CFrame = CFrame.lookAt(position, position + aim)
			CombatService.ReleasePunch(fighter, aim)
			brain.ChargeRelease = nil
			brain.NextAttack = now + rng:NextNumber(0.3, 0.7)
		end
		return
	end

	if distance <= Config.Combat.PunchRange * 0.9 then
		humanoid:Move(moveDir * 0.3, false)
		local cooldown = Config.Combat.PunchCooldown * fighter.Stats.PunchCooldownMult
		if now >= brain.NextAttack and now - fighter.LastPunch >= cooldown then
			root.CFrame = CFrame.lookAt(position, position + aim)
			if target.Heat > 55 and rng:NextNumber() < 0.35 + skill * 0.3 then
				if CombatService.BeginCharge(fighter) then
					brain.ChargeRelease = now + rng:NextNumber(0.45, 0.95)
				end
			else
				CombatService.ReleasePunch(fighter, aim)
			end
			brain.NextAttack = now + rng:NextNumber(0.12, 0.5) * (1.4 - skill)
		end
	else
		humanoid:Move(moveDir, false)
		if distance > 9 and distance < 18 and rng:NextNumber() < 0.03 + skill * 0.04 then
			if ArenaService.IsOverArena(position + aim * 16) then
				CombatService.TryDash(fighter, aim)
			end
		end
	end

	if rng:NextNumber() < 0.012 then
		humanoid.Jump = true
	end
end

function BotService.Init()
	task.spawn(function()
		while true do
			task.wait(0.1)
			local now = os.clock()
			for _, fighter in table.clone(bots) do
				local ok, err = pcall(function()
					if fighter.IsDummy then
						thinkDummy(fighter, now)
					elseif fighter.Alive and fighter.Zone == "Arena" and FighterService.IsAlive(fighter) then
						if CombatService.IsArenaLive() and not fighter.Frozen then
							think(fighter, now)
						else
							(fighter.Humanoid :: Humanoid):Move(Vector3.zero, false)
						end
					end
					if FighterService.IsAlive(fighter) then
						updateWalkAnimation(fighter)
					end
				end)
				if not ok then
					warn("[LaunchParty] Bot error:", fighter.Name, err)
				end
			end
		end
	end)
end

-- Lets events (e.g. the Sweeper) nudge bots into jumping.
function BotService.GetSkill(fighter: Fighter): number
	return if fighter.Brain and fighter.Brain.Skill then fighter.Brain.Skill else 0
end

return BotService
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000010">
					<Properties>
						<string name="Name">CombatService</string>
						<ProtectedString name="Source"><![CDATA[-- Server-authoritative combat. Clients only *request* actions; the server validates timing,
-- range and state, resolves hits against server-side positions, then tells physics owners to launch.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Knockback = require(Shared.Knockback)
local Movement = require(Shared.Movement)
local Net = require(Shared.Net)

local FighterService = require(script.Parent.FighterService)

type Fighter = FighterService.Fighter

local CombatService = {}

local C = Config.Combat
local effectRemote = Net.Event("Effect")

local arenaLive = false
local rateBuckets: { [Player]: { Tokens: number, Last: number } } = {}

-- Validation helpers -------------------------------------------------------------

local function isFiniteVector(value: any): boolean
	if typeof(value) ~= "Vector3" then
		return false
	end
	for _, axis in { value.X, value.Y, value.Z } do
		if axis ~= axis or math.abs(axis) > 1e5 then
			return false
		end
	end
	return true
end

local function flatUnit(value: any, fallback: Vector3): Vector3
	if isFiniteVector(value) then
		local flat = Vector3.new(value.X, 0, value.Z)
		if flat.Magnitude > 0.05 then
			return flat.Unit
		end
	end
	local flatFallback = Vector3.new(fallback.X, 0, fallback.Z)
	if flatFallback.Magnitude > 0.05 then
		return flatFallback.Unit
	end
	return Vector3.new(0, 0, -1)
end

local function allowRequest(player: Player): boolean
	local now = os.clock()
	local bucket = rateBuckets[player]
	if not bucket then
		bucket = { Tokens = C.MaxActionsPerSecond, Last = now }
		rateBuckets[player] = bucket
	end
	bucket.Tokens = math.min(C.MaxActionsPerSecond, bucket.Tokens + (now - bucket.Last) * C.MaxActionsPerSecond)
	bucket.Last = now
	if bucket.Tokens < 1 then
		return false
	end
	bucket.Tokens -= 1
	return true
end

-- State ----------------------------------------------------------------------------

function CombatService.SetArenaLive(live: boolean)
	arenaLive = live
	if not live then
		for _, fighter in FighterService.All() do
			if fighter.Zone == "Arena" and fighter.ChargeStart then
				FighterService.SetCharging(fighter, false)
			end
		end
	end
end

function CombatService.IsArenaLive(): boolean
	return arenaLive
end

function CombatService.CanAct(fighter: Fighter): boolean
	if fighter.Frozen or not FighterService.IsAlive(fighter) then
		return false
	end
	if fighter.Zone == "Lobby" then
		return true
	end
	return fighter.Zone == "Arena" and fighter.Alive and arenaLive
end

local function canBeHit(attacker: Fighter, target: Fighter): boolean
	if target == attacker or target.Zone ~= attacker.Zone or not FighterService.IsAlive(target) then
		return false
	end
	if target.Zone == "Arena" then
		return target.Alive
	end
	return target.Zone == "Lobby"
end

-- Hits ----------------------------------------------------------------------------

type HitSpec = {
	Heat: number,
	Knock: number,
	Direction: Vector3, -- flat unit vector
	Kind: string, -- "Jab" | "Charged" | "Shockwave" | "Bump" | environment names
	Power: number, -- 0..1, purely cosmetic
}

local function launch(victim: Fighter, attacker: Fighter?, spec: HitSpec)
	local victimStats = victim.Stats
	local dealtHeat = if attacker then attacker.Stats.HeatDealt else 1
	local dealtKnock = if attacker then attacker.Stats.KnockDealt else 1

	local heatGain = spec.Heat * dealtHeat * victimStats.HeatTaken
	FighterService.AddHeat(victim, heatGain)

	local speed = Knockback.Speed(spec.Knock, victim.Heat, dealtKnock, victimStats.KnockTaken, C)
	local velocity = spec.Direction * speed + Vector3.new(0, Knockback.Vertical(speed, C), 0)
	local tumble = Knockback.Tumble(speed, C)
	FighterService.ApplyKnockback(victim, velocity, tumble)

	if attacker then
		victim.LastHitBy = attacker
		victim.LastHitTime = os.clock()
		if attacker.Stats.LifeSteal > 0 then
			FighterService.AddHeat(attacker, -attacker.Stats.LifeSteal)
		end
		if victimStats.Thorns > 0 then
			FighterService.AddHeat(attacker, heatGain * victimStats.Thorns)
		end
	end

	effectRemote:FireAllClients("Hit", {
		Position = (victim.Root :: BasePart).Position,
		Attacker = if attacker then attacker.Id else nil,
		Victim = victim.Id,
		Kind = spec.Kind,
		Power = spec.Power,
		Speed = speed,
		Heat = math.floor(heatGain + 0.5),
	})
end

-- Environmental hazards (meteors, sweeper, gusts). Keeps existing KO credit intact.
function CombatService.EnvironmentHit(victim: Fighter, direction: Vector3, heat: number, knock: number, kind: string)
	if not FighterService.IsAlive(victim) then
		return
	end
	launch(victim, nil, {
		Heat = heat,
		Knock = knock,
		Direction = flatUnit(direction, Vector3.new(1, 0, 0)),
		Kind = kind,
		Power = 0.6,
	})
end

-- Actions (shared by remotes and bots) --------------------------------------------

function CombatService.BeginCharge(fighter: Fighter): boolean
	if not CombatService.CanAct(fighter) or fighter.ChargeStart then
		return false
	end
	if os.clock() < fighter.TumbleUntil then
		return false
	end
	FighterService.SetCharging(fighter, true)
	return true
end

function CombatService.ReleasePunch(fighter: Fighter, aimInput: any): boolean
	local now = os.clock()
	local chargeStart = fighter.ChargeStart
	if chargeStart then
		FighterService.SetCharging(fighter, false)
	end
	if not CombatService.CanAct(fighter) or now < fighter.TumbleUntil then
		return false
	end
	local stats = fighter.Stats
	local cooldown = C.PunchCooldown * stats.PunchCooldownMult
	if now - fighter.LastPunch < cooldown - 0.06 then
		return false
	end
	fighter.LastPunch = now

	local alpha = 0
	if chargeStart then
		alpha = math.clamp((now - chargeStart) * stats.ChargeSpeed / C.ChargeMaxTime, 0, 1)
	end
	local charged = alpha >= C.ChargeThreshold
	local power = if charged then alpha else 0

	local root = fighter.Root :: BasePart
	local aim = flatUnit(aimInput, root.CFrame.LookVector)
	local origin = root.Position
	local range = C.PunchRange + C.RangeLeniency + (if charged then C.ChargeRangeBonus else 0)

	if fighter.AnimPlayer then
		fighter.AnimPlayer(if charged then "Charged" else "Punch")
	end

	local candidates = {}
	for _, other in FighterService.All() do
		if canBeHit(fighter, other) then
			local offset = (other.Root :: BasePart).Position - origin
			local flat = Vector3.new(offset.X, 0, offset.Z)
			local distance = flat.Magnitude
			if distance <= range and math.abs(offset.Y) < 7 then
				local dot = if distance > 0.01 then flat.Unit:Dot(aim) else 1
				if dot >= C.PunchCone or distance < 2.5 then
					table.insert(candidates, { Fighter = other, Distance = distance, Flat = flat })
				end
			end
		end
	end
	table.sort(candidates, function(a, b)
		return a.Distance < b.Distance
	end)

	local heat = C.JabHeat * (1 + (C.ChargeHeatMult - 1) * power)
	local knock = C.JabKnock * (1 + (C.ChargeKnockMult - 1) * power)
	local hitSet: { [Fighter]: boolean } = {}
	local maxTargets = if charged then #candidates else math.min(1, #candidates)

	for i = 1, maxTargets do
		local entry = candidates[i]
		local toTarget = if entry.Distance > 0.01 then entry.Flat.Unit else aim
		local direction = (aim * 0.6 + toTarget * 0.4)
		hitSet[entry.Fighter] = true
		launch(entry.Fighter, fighter, {
			Heat = heat,
			Knock = knock,
			Direction = flatUnit(direction, aim),
			Kind = if charged then "Charged" else "Jab",
			Power = power,
		})
	end

	if charged and stats.Shockwave > 0 then
		effectRemote:FireAllClients("Shockwave", { Position = origin, Radius = C.ShockwaveRadius })
		for _, other in FighterService.All() do
			if not hitSet[other] and canBeHit(fighter, other) then
				local offset = (other.Root :: BasePart).Position - origin
				local flat = Vector3.new(offset.X, 0, offset.Z)
				if flat.Magnitude <= C.ShockwaveRadius and math.abs(offset.Y) < 9 then
					launch(other, fighter, {
						Heat = heat * C.ShockwavePower,
						Knock = knock * C.ShockwavePower,
						Direction = flatUnit(flat, aim),
						Kind = "Shockwave",
						Power = power,
					})
				end
			end
		end
	end
	return true
end

function CombatService.TryDash(fighter: Fighter, directionInput: any): boolean
	if not CombatService.CanAct(fighter) then
		return false
	end
	local now = os.clock()
	if now - fighter.LastHitTime < C.HitstunDashLock then
		return false
	end
	local slot = nil
	for index, readyAt in fighter.DashReady do
		if readyAt <= now + 0.08 then
			slot = index
			break
		end
	end
	if not slot then
		return false
	end
	fighter.DashReady[slot] = now + C.DashCooldown * fighter.Stats.DashCooldownMult

	local root = fighter.Root :: BasePart
	local direction = flatUnit(directionInput, root.CFrame.LookVector)
	if fighter.ChargeStart then
		FighterService.SetCharging(fighter, false)
	end
	fighter.TumbleUntil = 0
	fighter.DashUntil = now + C.DashDuration + 0.12
	fighter.DashDir = direction
	fighter.DashHits = {}

	if not fighter.Player then
		Movement.Dash(fighter.Humanoid :: Humanoid, root, direction, C)
		if fighter.AnimPlayer then
			fighter.AnimPlayer("Charged")
		end
	end
	effectRemote:FireAllClients("Dash", { Position = root.Position, Fighter = fighter.Id })
	return true
end

-- Per-frame: dash bumps, motion trails, dummy cooldown ----------------------------

local function step()
	local now = os.clock()
	local all = FighterService.All()
	for _, fighter in all do
		if FighterService.IsAlive(fighter) then
			local root = fighter.Root :: BasePart
			if fighter.Trail then
				fighter.Trail.Enabled = root.AssemblyLinearVelocity.Magnitude > 28
			end

			if fighter.DashUntil > now then
				for _, other in all do
					if not fighter.DashHits[other] and canBeHit(fighter, other) then
						local distance = ((other.Root :: BasePart).Position - root.Position).Magnitude
						if distance <= C.DashBumpRadius then
							fighter.DashHits[other] = true
							launch(other, fighter, {
								Heat = C.DashBumpHeat,
								Knock = C.DashBumpKnock * fighter.Stats.BumpMult,
								Direction = fighter.DashDir,
								Kind = "Bump",
								Power = 0.4,
							})
						end
					end
				end
			end

			if fighter.IsDummy and fighter.Heat > 0 and now - fighter.LastHitTime > 3 then
				FighterService.SetHeat(fighter, 0)
			end
		end
	end
end

function CombatService.Init()
	Net.Event("ChargeStart").OnServerEvent:Connect(function(player)
		if not allowRequest(player) then
			return
		end
		local fighter = FighterService.GetByPlayer(player)
		if fighter then
			CombatService.BeginCharge(fighter)
		end
	end)

	Net.Event("Punch").OnServerEvent:Connect(function(player, aim)
		if not allowRequest(player) then
			return
		end
		local fighter = FighterService.GetByPlayer(player)
		if fighter then
			CombatService.ReleasePunch(fighter, aim)
		end
	end)

	Net.Event("Dash").OnServerEvent:Connect(function(player, direction)
		if not allowRequest(player) then
			return
		end
		local fighter = FighterService.GetByPlayer(player)
		if fighter then
			CombatService.TryDash(fighter, direction)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		rateBuckets[player] = nil
	end)

	RunService.Heartbeat:Connect(function()
		local ok, err = pcall(step)
		if not ok then
			warn("[LaunchParty] Combat step error:", err)
		end
	end)
end

return CombatService
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000011">
					<Properties>
						<string name="Name">DataService</string>
						<ProtectedString name="Source"><![CDATA[-- Persistent profiles (XP, wins, KOs) with retries, autosave and a safe offline fallback.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Perks = require(Shared.Perks)
local Progression = require(Shared.Progression)

local DataService = {}

local STORE_NAME = "LaunchParty_Profiles_v1"
local AUTOSAVE_INTERVAL = 120
local RETRIES = if RunService:IsStudio() then 1 else 3

type Profile = { Data: { [string]: any }, Persistent: boolean, Dirty: boolean }

local profiles: { [Player]: Profile } = {}
local loadedEvent = Instance.new("BindableEvent")
DataService.ProfileLoaded = loadedEvent.Event

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[LaunchParty] DataStores unavailable, progress will not save this session:", result)
	end
end

local function defaultData(): { [string]: any }
	return {
		Version = 1,
		XP = 0,
		Wins = 0,
		KOs = 0,
		Matches = 0,
		LastDailyWin = "",
	}
end

local function reconcile(data: any): { [string]: any }
	if type(data) ~= "table" then
		return defaultData()
	end
	for key, value in defaultData() do
		if type(data[key]) ~= type(value) then
			data[key] = value
		end
	end
	return data
end

local function withRetries(label: string, callback: () -> any): (boolean, any)
	local lastError = nil
	for attempt = 1, RETRIES do
		local ok, result = pcall(callback)
		if ok then
			return true, result
		end
		lastError = result
		if attempt < RETRIES then
			task.wait(2 ^ attempt)
		end
	end
	warn(string.format("[LaunchParty] %s failed: %s", label, tostring(lastError)))
	return false, lastError
end

local function keyFor(player: Player): string
	return "u_" .. player.UserId
end

local function publish(player: Player)
	local profile = profiles[player]
	if not profile then
		return
	end
	local data = profile.Data
	local level, into, needed = Progression.FromXP(data.XP)
	local tier, title = Progression.TitleFor(level)

	player:SetAttribute("Level", level)
	player:SetAttribute("XPInto", into)
	player:SetAttribute("XPNeeded", needed)
	player:SetAttribute("Title", title)
	player:SetAttribute("TitleTier", tier)
	player:SetAttribute("DataPersistent", profile.Persistent)

	local leaderstats = player:FindFirstChild("leaderstats")
	if leaderstats then
		local values = { Level = level, Wins = data.Wins, KOs = data.KOs }
		for name, value in values do
			local stat = leaderstats:FindFirstChild(name)
			if stat and stat:IsA("IntValue") then
				stat.Value = value
			end
		end
	end
end

local function createLeaderstats(player: Player)
	if player:FindFirstChild("leaderstats") then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	for _, name in { "Level", "Wins", "KOs" } do
		local value = Instance.new("IntValue")
		value.Name = name
		value.Parent = folder
	end
	folder.Parent = player
end

function DataService.Load(player: Player)
	local data = nil
	local persistent = false
	if store then
		local ok, result = withRetries("Load " .. player.Name, function()
			return (store :: DataStore):GetAsync(keyFor(player))
		end)
		if ok then
			data = result
			persistent = true
		end
	end
	if not player.Parent then
		return
	end
	profiles[player] = { Data = reconcile(data), Persistent = persistent, Dirty = false }
	createLeaderstats(player)
	publish(player)
	loadedEvent:Fire(player)
end

function DataService.Save(player: Player)
	local profile = profiles[player]
	if not profile or not profile.Persistent or not store or not profile.Dirty then
		return
	end
	local snapshot = table.clone(profile.Data)
	local ok = withRetries("Save " .. player.Name, function()
		(store :: DataStore):UpdateAsync(keyFor(player), function()
			return snapshot
		end)
	end)
	if ok then
		profile.Dirty = false
	end
end

function DataService.IsLoaded(player: Player): boolean
	return profiles[player] ~= nil
end

function DataService.GetLevel(player: Player): number
	local profile = profiles[player]
	if not profile then
		return 1
	end
	return (Progression.FromXP(profile.Data.XP))
end

function DataService.AddKO(player: Player)
	local profile = profiles[player]
	if profile then
		profile.Data.KOs += 1
		profile.Dirty = true
		publish(player)
	end
end

export type MatchInput = { Points: number, KOs: number, Placement: number, Won: boolean }

function DataService.AwardMatch(player: Player, result: MatchInput): { [string]: any }?
	local profile = profiles[player]
	if not profile then
		return nil
	end
	local data = profile.Data
	local today = os.date("!%Y-%m-%d")
	local daily = result.Won and data.LastDailyWin ~= today

	local xp, breakdown = Progression.MatchXP({
		Points = result.Points,
		KOs = result.KOs,
		Placement = result.Placement,
		Won = result.Won,
		DailyBonus = daily,
	})
	local oldLevel = Progression.FromXP(data.XP)
	data.XP += xp
	data.Matches += 1
	if result.Won then
		data.Wins += 1
	end
	if daily then
		data.LastDailyWin = today
	end
	local newLevel, into, needed = Progression.FromXP(data.XP)

	local unlocks = {}
	for _, def in Perks.List do
		if def.UnlockLevel > oldLevel and def.UnlockLevel <= newLevel then
			table.insert(unlocks, "New perk: " .. def.Name)
		end
	end
	for _, entry in Progression.Titles do
		if entry.Level > oldLevel and entry.Level <= newLevel then
			table.insert(unlocks, "New title & trail: " .. entry.Name)
		end
	end

	profile.Dirty = true
	publish(player)
	return {
		XP = xp,
		Breakdown = breakdown,
		OldLevel = oldLevel,
		NewLevel = newLevel,
		XPInto = into,
		XPNeeded = needed,
		Unlocks = unlocks,
		Daily = daily,
		Persistent = profile.Persistent,
	}
end

function DataService.Init()
	Players.PlayerRemoving:Connect(function(player)
		DataService.Save(player)
		profiles[player] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_INTERVAL)
			for player in profiles do
				task.spawn(DataService.Save, player)
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				DataService.Save(player)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000012">
					<Properties>
						<string name="Name">DraftService</string>
						<ProtectedString name="Source"><![CDATA[-- Between rounds every fighter picks 1 of 3 perk cards. Low placers get luckier rolls.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Draft = require(Shared.Draft)
local Net = require(Shared.Net)
local Perks = require(Shared.Perks)

local DataService = require(script.Parent.DataService)
local FighterService = require(script.Parent.FighterService)

type Fighter = FighterService.Fighter

local DraftService = {}

local offerRemote = Net.Event("DraftOffer")
local closeRemote = Net.Event("DraftClose")
local pickRemote = Net.Event("DraftPick")
local feedRemote = Net.Event("KillFeed")

local rng = Random.new()

type Pending = { Fighter: Fighter, Cards: { Perks.PerkDef }, Picked: boolean }
local pendingByPlayer: { [Player]: Pending } = {}

local function serialize(fighter: Fighter, cards: { Perks.PerkDef })
	local list = {}
	for _, def in cards do
		table.insert(list, {
			Id = def.Id,
			Name = def.Name,
			Description = def.Description,
			Rarity = def.Rarity,
			Owned = fighter.Perks[def.Id] or 0,
			MaxStacks = def.MaxStacks,
		})
	end
	return list
end

local function commit(pending: Pending, index: number)
	if pending.Picked then
		return
	end
	local def = pending.Cards[index]
	if not def then
		return
	end
	pending.Picked = true
	FighterService.AddPerk(pending.Fighter, def.Id)
	if def.Rarity == "Legendary" then
		feedRemote:FireAllClients({ Text = string.format("✨ %s drafted %s!", pending.Fighter.Name, def.Name) })
	end
end

-- Blocks until everyone picks or time runs out (unpicked fighters get a random card).
function DraftService.Run(participants: { Fighter }, luckBy: { [Fighter]: number }, duration: number)
	local endsAt = Workspace:GetServerTimeNow() + duration
	local all: { Pending } = {}

	for _, fighter in participants do
		local level = if fighter.Player then DataService.GetLevel(fighter.Player) else 99
		local pool = Perks.Pool(level)
		local cards = Draft.Roll(pool, fighter.Perks, 3, luckBy[fighter] or 0.5, rng) :: { any }
		if #cards > 0 then
			local pending: Pending = { Fighter = fighter, Cards = cards, Picked = false }
			table.insert(all, pending)
			if fighter.Player and fighter.Player.Parent then
				pendingByPlayer[fighter.Player] = pending
				offerRemote:FireClient(fighter.Player, serialize(fighter, cards), endsAt)
			else
				task.delay(rng:NextNumber(1, 3), function()
					commit(pending, rng:NextInteger(1, #pending.Cards))
				end)
			end
		end
	end

	while Workspace:GetServerTimeNow() < endsAt do
		local waiting = false
		for _, pending in all do
			if not pending.Picked and (not pending.Fighter.Player or pending.Fighter.Player.Parent) then
				waiting = true
				break
			end
		end
		if not waiting then
			break
		end
		task.wait(0.2)
	end

	for _, pending in all do
		if not pending.Picked then
			commit(pending, rng:NextInteger(1, #pending.Cards))
		end
	end
	table.clear(pendingByPlayer)
	closeRemote:FireAllClients()
	task.wait(0.6)
end

function DraftService.Init()
	pickRemote.OnServerEvent:Connect(function(player, index)
		local pending = pendingByPlayer[player]
		if not pending or type(index) ~= "number" or index ~= index then
			return
		end
		index = math.floor(index)
		if index < 1 or index > #pending.Cards then
			return
		end
		commit(pending, index)
	end)
end

return DraftService
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000013">
					<Properties>
						<string name="Name">EventService</string>
						<ProtectedString name="Source"><![CDATA[-- Round modifiers. Each event has Start() which returns a cleanup function.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local ArenaService = require(script.Parent.ArenaService)
local BotService = require(script.Parent.BotService)
local CombatService = require(script.Parent.CombatService)
local FighterService = require(script.Parent.FighterService)

local EventService = {}

local E = Config.Events
local effectRemote = Net.Event("Effect")
local rng = Random.new()

export type EventDef = {
	Id: string,
	Name: string,
	Description: string,
	Start: () -> () -> (),
}

local function noop() end

local function flatOffset(a: Vector3, b: Vector3): Vector3
	local offset = a - b
	return Vector3.new(offset.X, 0, offset.Z)
end

local function hazardFolder(): Folder
	local folder = Instance.new("Folder")
	folder.Name = "EventHazards"
	folder.Parent = Workspace
	return folder
end

-- Meteor Shower ---------------------------------------------------------------------

local function dropMeteor(folder: Folder, target: Vector3)
	local warning = Instance.new("Part")
	warning.Name = "MeteorWarning"
	warning.Shape = Enum.PartType.Cylinder
	warning.Size = Vector3.new(0.2, E.MeteorRadius * 2, E.MeteorRadius * 2)
	warning.CFrame = CFrame.new(target + Vector3.new(0, 0.15, 0)) * CFrame.Angles(0, 0, math.rad(90))
	warning.Anchored = true
	warning.CanCollide = false
	warning.CanQuery = false
	warning.CanTouch = false
	warning.Material = Enum.Material.Neon
	warning.Color = Color3.fromRGB(255, 70, 50)
	warning.Transparency = 0.65
	warning.Parent = folder
	TweenService:Create(warning, TweenInfo.new(0.25, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
		Transparency = 0.25,
	}):Play()

	local meteor = Instance.new("Part")
	meteor.Name = "Meteor"
	meteor.Shape = Enum.PartType.Ball
	meteor.Size = Vector3.one * 6
	meteor.Material = Enum.Material.Basalt
	meteor.Color = Color3.fromRGB(80, 50, 40)
	meteor.Anchored = true
	meteor.CanCollide = false
	meteor.CanQuery = false
	meteor.CanTouch = false
	local start = target + Vector3.new(rng:NextNumber(-30, 30), 95, rng:NextNumber(-30, 30))
	meteor.CFrame = CFrame.new(start)
	local fire = Instance.new("Fire")
	fire.Size = 9
	fire.Heat = 15
	fire.Parent = meteor
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 140, 60)
	light.Range = 18
	light.Brightness = 3
	light.Parent = meteor
	meteor.Parent = folder

	local fall = TweenService:Create(meteor, TweenInfo.new(1.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		CFrame = CFrame.new(target + Vector3.new(0, 2, 0)),
	})
	fall.Completed:Connect(function(state)
		warning:Destroy()
		meteor:Destroy()
		if state ~= Enum.PlaybackState.Completed or not folder.Parent then
			return
		end
		effectRemote:FireAllClients("Meteor", { Position = target, Radius = E.MeteorRadius })
		for _, fighter in FighterService.AliveInArena() do
			local offset = flatOffset((fighter.Root :: BasePart).Position, target)
			if offset.Magnitude <= E.MeteorRadius then
				local direction = if offset.Magnitude > 0.1 then offset.Unit else Vector3.new(rng:NextNumber(-1, 1), 0, 1)
				CombatService.EnvironmentHit(fighter, direction, E.MeteorHeat, E.MeteorKnock, "Meteor")
			end
		end
		ArenaService.BreakTilesNear(target, 4)
	end)
	fall:Play()
end

local function startMeteors(): () -> ()
	local folder = hazardFolder()
	local running = true
	task.spawn(function()
		task.wait(2)
		while running do
			local target = ArenaService.RandomTilePosition()
			if target then
				dropMeteor(folder, target)
			end
			task.wait(rng:NextNumber(E.MeteorInterval[1], E.MeteorInterval[2]))
		end
	end)
	return function()
		running = false
		folder:Destroy()
	end
end

-- The Sweeper ------------------------------------------------------------------------

local function startSweeper(): () -> ()
	local folder = hazardFolder()
	local center = ArenaService.GetCenter()
	local length = Config.Arena.Radius * 2 + 10

	local beam = Instance.new("Part")
	beam.Name = "SweeperBeam"
	beam.Size = Vector3.new(length, 1.6, 1.6)
	beam.Anchored = true
	beam.CanCollide = false
	beam.CanQuery = false
	beam.CanTouch = false
	beam.Material = Enum.Material.Neon
	beam.Color = Color3.fromRGB(255, 60, 90)
	beam.Parent = folder

	local hub = Instance.new("Part")
	hub.Name = "SweeperHub"
	hub.Shape = Enum.PartType.Cylinder
	hub.Size = Vector3.new(5, 5, 5)
	hub.CFrame = CFrame.new(center + Vector3.new(0, 2.5, 0)) * CFrame.Angles(0, 0, math.rad(90))
	hub.Anchored = true
	hub.Material = Enum.Material.Metal
	hub.Color = Color3.fromRGB(50, 50, 60)
	hub.Parent = folder

	local angle = rng:NextNumber(0, math.pi * 2)
	local started = os.clock()
	local cooldowns: { [any]: number } = {}

	local connection = RunService.Heartbeat:Connect(function(dt)
		local ramp = math.clamp((os.clock() - started) / 40, 0, 1)
		local omega = E.SweeperSpeed[1] + (E.SweeperSpeed[2] - E.SweeperSpeed[1]) * ramp
		angle += omega * dt
		beam.CFrame = CFrame.new(center + Vector3.new(0, 2.2, 0)) * CFrame.Angles(0, angle, 0)
		if not CombatService.IsArenaLive() then
			return
		end

		local axis = Vector3.new(math.cos(angle), 0, -math.sin(angle))
		local sweepDir = Vector3.new(-math.sin(angle), 0, -math.cos(angle))
		local now = os.clock()
		for _, fighter in FighterService.AliveInArena() do
			local position = (fighter.Root :: BasePart).Position
			local relative = flatOffset(position, center)
			local along = relative:Dot(axis)
			local perpendicular = (relative - axis * along).Magnitude
			local height = position.Y - center.Y
			if math.abs(along) <= length / 2 and perpendicular < 2.6 and height < 4.6 then
				if (cooldowns[fighter] or 0) <= now then
					cooldowns[fighter] = now + 0.7
					local push = sweepDir * (if along >= 0 then 1 else -1)
					CombatService.EnvironmentHit(fighter, push, E.SweeperHeat, E.SweeperKnock, "Sweeper")
				end
			elseif fighter.IsBot and perpendicular < 6 and height < 4.6 then
				-- Bots try to hop the beam, better bots more reliably.
				if rng:NextNumber() < 0.05 + BotService.GetSkill(fighter) * 0.12 then
					(fighter.Humanoid :: Humanoid).Jump = true
				end
			end
		end
	end)

	return function()
		connection:Disconnect()
		folder:Destroy()
	end
end

-- Gusts ------------------------------------------------------------------------------

local function startGusts(): () -> ()
	local running = true
	task.spawn(function()
		task.wait(4)
		while running do
			local angle = rng:NextNumber(0, math.pi * 2)
			local direction = Vector3.new(math.cos(angle), 0, math.sin(angle))
			effectRemote:FireAllClients("GustWarning", { Direction = direction, Center = ArenaService.GetCenter() })
			task.wait(E.GustWarning)
			if not running then
				break
			end
			effectRemote:FireAllClients("Gust", { Direction = direction, Center = ArenaService.GetCenter() })
			for _, fighter in FighterService.AliveInArena() do
				CombatService.EnvironmentHit(fighter, direction, 0, E.GustKnock, "Gust")
			end
			task.wait(E.GustInterval)
		end
	end)
	return function()
		running = false
	end
end

-- Registry ---------------------------------------------------------------------------

EventService.Classic = {
	Id = "Classic",
	Name = "Classic",
	Description = "No tricks. Just fists.",
	Start = function()
		return noop
	end,
} :: EventDef

EventService.Events = {
	{
		Id = "LowGravity",
		Name = "Low Gravity",
		Description = "Floaty jumps. Launches go to the moon.",
		Start = function()
			Workspace.Gravity = E.LowGravity
			return function()
				Workspace.Gravity = E.DefaultGravity
			end
		end,
	},
	{
		Id = "Meteors",
		Name = "Meteor Shower",
		Description = "Watch the red circles. They punch holes in the arena.",
		Start = startMeteors,
	},
	{
		Id = "Ice",
		Name = "Ice Rink",
		Description = "Zero friction. Every hit slides you way further.",
		Start = function()
			ArenaService.SetIce(true)
			return noop
		end,
	},
	{
		Id = "Sweeper",
		Name = "The Sweeper",
		Description = "A spinning beam that speeds up. JUMP!",
		Start = startSweeper,
	},
	{
		Id = "Gusts",
		Name = "Gusty Skies",
		Description = "Wind blasts everyone sideways. Brace yourself.",
		Start = startGusts,
	},
} :: { EventDef }

local lastEventId: string? = nil
local activeStop: (() -> ())? = nil

function EventService.Pick(round: number): EventDef
	if round == 1 then
		lastEventId = EventService.Classic.Id
		return EventService.Classic
	end
	local options = {}
	for _, event in EventService.Events do
		if event.Id ~= lastEventId then
			table.insert(options, event)
		end
	end
	local chosen = options[rng:NextInteger(1, #options)]
	lastEventId = chosen.Id
	return chosen
end

function EventService.Start(event: EventDef)
	EventService.Stop()
	local ok, result = pcall(event.Start)
	if ok and type(result) == "function" then
		activeStop = result
	else
		warn("[LaunchParty] Event failed to start:", event.Id, result)
	end
end

function EventService.Stop()
	local stop = activeStop
	activeStop = nil
	if stop then
		local ok, err = pcall(stop)
		if not ok then
			warn("[LaunchParty] Event cleanup failed:", err)
		end
	end
	Workspace.Gravity = E.DefaultGravity
end

return EventService
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000014">
					<Properties>
						<string name="Name">FighterService</string>
						<ProtectedString name="Source"><![CDATA[-- Registry of every combatant (players, bots, lobby dummies) plus their match state.
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Cosmetics = require(Shared.Cosmetics)
local Movement = require(Shared.Movement)
local Net = require(Shared.Net)
local Perks = require(Shared.Perks)

local FighterService = {}

export type Fighter = {
	Id: string,
	Name: string,
	Player: Player?,
	IsBot: boolean,
	IsDummy: boolean,
	Model: Model?,
	Humanoid: Humanoid?,
	Root: BasePart?,
	Tag: BillboardGui?,
	Trail: Trail?,
	Highlight: Highlight?,
	ModelConnections: { RBXScriptConnection },

	Zone: string, -- "Lobby" | "Arena" | "None"
	Alive: boolean, -- still in the current round
	Frozen: boolean,
	Heat: number,
	Perks: { [string]: number },
	Stats: Perks.Stats,
	Points: number,
	KOs: number,
	LivesLeft: number,
	Crowned: boolean,
	InMatch: boolean,
	Placement: number,

	LastHitBy: any?,
	LastHitTime: number,
	TumbleUntil: number,
	VoidImmuneUntil: number,
	LastPunch: number,
	ChargeStart: number?,
	DashReady: { number },
	DashUntil: number,
	DashDir: Vector3,
	DashHits: { [any]: boolean },

	Level: number,
	TitleName: string,
	TrailTier: number,
	AnimPlayer: ((string) -> ())?,
	Brain: any?,
	Home: CFrame?,
}

local fighters: { [string]: Fighter } = {}
local knockbackRemote = Net.Event("Knockback")

function FighterService.New(id: string, name: string, options: { Player: Player?, IsBot: boolean?, IsDummy: boolean? }): Fighter
	local fighter: Fighter = {
		Id = id,
		Name = name,
		Player = options.Player,
		IsBot = options.IsBot == true,
		IsDummy = options.IsDummy == true,
		Model = nil,
		Humanoid = nil,
		Root = nil,
		Tag = nil,
		Trail = nil,
		Highlight = nil,
		ModelConnections = {},

		Zone = "None",
		Alive = false,
		Frozen = false,
		Heat = 0,
		Perks = {},
		Stats = Perks.Compute({}),
		Points = 0,
		KOs = 0,
		LivesLeft = 0,
		Crowned = false,
		InMatch = false,
		Placement = 0,

		LastHitBy = nil,
		LastHitTime = -math.huge,
		TumbleUntil = 0,
		VoidImmuneUntil = 0,
		LastPunch = -math.huge,
		ChargeStart = nil,
		DashReady = { 0 },
		DashUntil = 0,
		DashDir = Vector3.zero,
		DashHits = {},

		Level = 1,
		TitleName = "Rookie",
		TrailTier = 1,
		AnimPlayer = nil,
		Brain = nil,
		Home = nil,
	}
	fighters[id] = fighter
	return fighter
end

function FighterService.Get(id: string): Fighter?
	return fighters[id]
end

function FighterService.GetByPlayer(player: Player): Fighter?
	return fighters["P" .. player.UserId]
end

function FighterService.All(): { Fighter }
	local list = {}
	for _, fighter in fighters do
		table.insert(list, fighter)
	end
	return list
end

function FighterService.IsAlive(fighter: Fighter): boolean
	local model, humanoid, root = fighter.Model, fighter.Humanoid, fighter.Root
	return model ~= nil
		and model.Parent ~= nil
		and humanoid ~= nil
		and humanoid.Health > 0
		and root ~= nil
		and root.Parent ~= nil
end

-- Fighters still alive in the current round's arena.
function FighterService.AliveInArena(): { Fighter }
	local list = {}
	for _, fighter in fighters do
		if fighter.Alive and fighter.Zone == "Arena" and FighterService.IsAlive(fighter) then
			table.insert(list, fighter)
		end
	end
	return list
end

-- Cosmetic tag ---------------------------------------------------------------

local function createTag(fighter: Fighter, model: Model): BillboardGui
	local adornee = model:FindFirstChild("Head") or fighter.Root
	local gui = Instance.new("BillboardGui")
	gui.Name = "FighterTag"
	gui.Size = UDim2.fromOffset(220, 58)
	gui.StudsOffset = Vector3.new(0, 2.6, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 160
	gui.LightInfluence = 0
	gui.Adornee = adornee :: BasePart

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "NameLabel"
	nameLabel.BackgroundTransparency = 1
	nameLabel.Size = UDim2.new(1, 0, 0.4, 0)
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextScaled = true
	nameLabel.TextColor3 = Color3.new(1, 1, 1)
	nameLabel.TextStrokeTransparency = 0.35
	nameLabel.Parent = gui

	local heatLabel = Instance.new("TextLabel")
	heatLabel.Name = "HeatLabel"
	heatLabel.BackgroundTransparency = 1
	heatLabel.Position = UDim2.new(0, 0, 0.4, 0)
	heatLabel.Size = UDim2.new(1, 0, 0.6, 0)
	heatLabel.Font = Enum.Font.FredokaOne
	heatLabel.TextScaled = true
	heatLabel.TextStrokeTransparency = 0.2
	heatLabel.Parent = gui

	gui.Parent = model
	return gui
end

local function createTrail(fighter: Fighter, root: BasePart): Trail
	local top = Instance.new("Attachment")
	top.Name = "TrailTop"
	top.Position = Vector3.new(0, 0.9, 0)
	top.Parent = root
	local bottom = Instance.new("Attachment")
	bottom.Name = "TrailBottom"
	bottom.Position = Vector3.new(0, -0.9, 0)
	bottom.Parent = root

	local trail = Instance.new("Trail")
	trail.Name = "LaunchTrail"
	trail.Attachment0 = top
	trail.Attachment1 = bottom
	trail.Lifetime = 0.3
	trail.MinLength = 0.1
	trail.FaceCamera = true
	trail.LightEmission = 0.6
	trail.Transparency = NumberSequence.new(0.25, 1)
	trail.WidthScale = NumberSequence.new(1, 0.2)
	trail.Color = Cosmetics.TrailFor(fighter.TrailTier)
	trail.Enabled = false
	trail.Parent = root
	return trail
end

function FighterService.RefreshTag(fighter: Fighter)
	local tag = fighter.Tag
	if not tag or not tag.Parent then
		return
	end
	local nameLabel = tag:FindFirstChild("NameLabel") :: TextLabel?
	local heatLabel = tag:FindFirstChild("HeatLabel") :: TextLabel?
	if nameLabel then
		local prefix = if fighter.Crowned then "👑 " else ""
		local suffix = if fighter.IsDummy then "" elseif fighter.IsBot then "  · BOT" else "  · " .. fighter.TitleName
		nameLabel.Text = prefix .. fighter.Name .. suffix
		nameLabel.TextColor3 = if fighter.Crowned then Color3.fromRGB(255, 220, 90) else Color3.new(1, 1, 1)
	end
	if heatLabel then
		heatLabel.Text = string.format("%d%%", math.floor(fighter.Heat))
		heatLabel.TextColor3 = Cosmetics.HeatColor(fighter.Heat)
	end
end

function FighterService.RefreshCosmetics(fighter: Fighter)
	if fighter.Trail then
		fighter.Trail.Color = Cosmetics.TrailFor(fighter.TrailTier)
	end
	FighterService.RefreshTag(fighter)
end

-- Model binding ----------------------------------------------------------------

function FighterService.UnbindModel(fighter: Fighter)
	for _, connection in fighter.ModelConnections do
		connection:Disconnect()
	end
	table.clear(fighter.ModelConnections)
	if fighter.Model then
		CollectionService:RemoveTag(fighter.Model, "Fighter")
	end
	fighter.Model = nil
	fighter.Humanoid = nil
	fighter.Root = nil
	fighter.Tag = nil
	fighter.Trail = nil
	fighter.Highlight = nil
	fighter.ChargeStart = nil
end

function FighterService.BindModel(fighter: Fighter, model: Model): boolean
	FighterService.UnbindModel(fighter)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not humanoid or not root then
		warn("[LaunchParty] Cannot bind fighter without Humanoid/HumanoidRootPart:", fighter.Name)
		return false
	end

	fighter.Model = model
	fighter.Humanoid = humanoid
	fighter.Root = root
	model:SetAttribute("FighterId", fighter.Id)
	model:SetAttribute("Heat", fighter.Heat)
	CollectionService:AddTag(model, "Fighter")
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.BreakJointsOnDeath = false

	fighter.Tag = createTag(fighter, model)
	fighter.Trail = createTrail(fighter, root)
	FighterService.ApplyStats(fighter)
	FighterService.RefreshTag(fighter)

	table.insert(
		fighter.ModelConnections,
		model.AncestryChanged:Connect(function(_, parent)
			if parent == nil and fighter.Model == model then
				FighterService.UnbindModel(fighter)
			end
		end)
	)
	return true
end

-- Stats, heat & movement --------------------------------------------------------

function FighterService.RefreshMovement(fighter: Fighter)
	local humanoid = fighter.Humanoid
	if not humanoid or not humanoid.Parent then
		return
	end
	local walk = fighter.Stats.WalkSpeed
	if fighter.ChargeStart then
		walk *= Config.Combat.ChargeWalkMult
	end
	humanoid.UseJumpPower = true
	humanoid.WalkSpeed = if fighter.Frozen then 0 else walk
	humanoid.JumpPower = if fighter.Frozen then 0 else fighter.Stats.JumpPower
end

function FighterService.ApplyStats(fighter: Fighter)
	local stats = fighter.Stats
	while #fighter.DashReady < stats.DashCharges do
		table.insert(fighter.DashReady, 0)
	end
	while #fighter.DashReady > stats.DashCharges do
		table.remove(fighter.DashReady)
	end
	FighterService.RefreshMovement(fighter)

	local model = fighter.Model
	if model and model.Parent then
		local ok, current = pcall(function()
			return model:GetScale()
		end)
		if ok and math.abs(current - stats.Scale) > 0.01 then
			local scaled, err = pcall(function()
				model:ScaleTo(stats.Scale)
			end)
			if not scaled then
				warn("[LaunchParty] ScaleTo failed:", err)
			end
		end
	end

	local player = fighter.Player
	if player then
		player:SetAttribute("PunchCooldown", Config.Combat.PunchCooldown * stats.PunchCooldownMult)
		player:SetAttribute("DashCooldown", Config.Combat.DashCooldown * stats.DashCooldownMult)
		player:SetAttribute("DashCharges", stats.DashCharges)
		player:SetAttribute("ChargeSpeed", stats.ChargeSpeed)
	end
end

function FighterService.SetPerks(fighter: Fighter, owned: { [string]: number })
	fighter.Perks = owned
	fighter.Stats = Perks.Compute(owned)
	FighterService.ApplyStats(fighter)
end

function FighterService.AddPerk(fighter: Fighter, perkId: string): boolean
	local def = Perks.ById[perkId]
	if not def then
		return false
	end
	local stacks = fighter.Perks[perkId] or 0
	if stacks >= def.MaxStacks then
		return false
	end
	local owned = table.clone(fighter.Perks)
	owned[perkId] = stacks + 1
	FighterService.SetPerks(fighter, owned)
	return true
end

function FighterService.SetHeat(fighter: Fighter, heat: number)
	local cap = if fighter.Zone == "Lobby" then Config.Lobby.HeatCap else 999
	fighter.Heat = math.clamp(heat, 0, cap)
	if fighter.Model then
		fighter.Model:SetAttribute("Heat", fighter.Heat)
	end
	FighterService.RefreshTag(fighter)
end

function FighterService.AddHeat(fighter: Fighter, amount: number)
	FighterService.SetHeat(fighter, fighter.Heat + amount)
end

function FighterService.SetFrozen(fighter: Fighter, frozen: boolean)
	fighter.Frozen = frozen
	FighterService.RefreshMovement(fighter)
end

function FighterService.SetCharging(fighter: Fighter, charging: boolean)
	if charging then
		fighter.ChargeStart = os.clock()
		if fighter.Model and not fighter.Highlight then
			local highlight = Instance.new("Highlight")
			highlight.Name = "ChargeGlow"
			highlight.FillColor = Color3.fromRGB(255, 150, 40)
			highlight.OutlineColor = Color3.fromRGB(255, 230, 120)
			highlight.FillTransparency = 0.6
			highlight.OutlineTransparency = 0
			highlight.DepthMode = Enum.HighlightDepthMode.Occluded
			highlight.Parent = fighter.Model
			fighter.Highlight = highlight
		end
	else
		fighter.ChargeStart = nil
		if fighter.Highlight then
			fighter.Highlight:Destroy()
			fighter.Highlight = nil
		end
	end
	FighterService.RefreshMovement(fighter)
end

-- Physics owner applies the launch: the client for players, the server for bots.
function FighterService.ApplyKnockback(fighter: Fighter, velocity: Vector3, tumble: number)
	if not FighterService.IsAlive(fighter) then
		return
	end
	fighter.TumbleUntil = os.clock() + tumble
	fighter.DashUntil = 0
	if fighter.ChargeStart then
		FighterService.SetCharging(fighter, false)
	end
	if fighter.Player then
		knockbackRemote:FireClient(fighter.Player, velocity, tumble)
	else
		Movement.Knockback(fighter.Humanoid :: Humanoid, fighter.Root :: BasePart, velocity, tumble)
	end
end

function FighterService.Teleport(fighter: Fighter, cframe: CFrame)
	if not FighterService.IsAlive(fighter) then
		return
	end
	(fighter.Model :: Model):PivotTo(cframe)
	FighterService.ApplyKnockback(fighter, Vector3.zero, 0)
end

-- Match lifecycle ---------------------------------------------------------------

function FighterService.ResetForMatch(fighter: Fighter)
	fighter.Points = 0
	fighter.KOs = 0
	fighter.Crowned = false
	fighter.Placement = 0
	fighter.LastHitBy = nil
	fighter.LivesLeft = 0
	FighterService.SetPerks(fighter, {})
	FighterService.SetHeat(fighter, 0)
end

function FighterService.ResetForRound(fighter: Fighter)
	fighter.Alive = false
	fighter.LastHitBy = nil
	fighter.LastHitTime = -math.huge
	fighter.TumbleUntil = 0
	fighter.VoidImmuneUntil = 0
	fighter.DashUntil = 0
	fighter.LivesLeft = fighter.Stats.ExtraLives
	for i in fighter.DashReady do
		fighter.DashReady[i] = 0
	end
	FighterService.SetCharging(fighter, false)
	FighterService.SetHeat(fighter, 0)
end

function FighterService.Remove(fighter: Fighter)
	FighterService.UnbindModel(fighter)
	fighters[fighter.Id] = nil
end

return FighterService
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000015">
					<Properties>
						<string name="Name">RoundService</string>
						<ProtectedString name="Source"><![CDATA[-- The match loop: Waiting -> Intermission -> [Countdown -> Live -> RoundEnd -> Draft] x N -> MatchEnd.
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Progression = require(Shared.Progression)

local ArenaService = require(script.Parent.ArenaService)
local BotService = require(script.Parent.BotService)
local CombatService = require(script.Parent.CombatService)
local DataService = require(script.Parent.DataService)
local DraftService = require(script.Parent.DraftService)
local EventService = require(script.Parent.EventService)
local FighterService = require(script.Parent.FighterService)

type Fighter = FighterService.Fighter

local RoundService = {}

local M = Config.Match
local gameState = Net.GameState()
local announceRemote = Net.Event("Announce")
local feedRemote = Net.Event("KillFeed")
local effectRemote = Net.Event("Effect")
local resultsRemote = Net.Event("MatchResults")

local rng = Random.new()
local participants: { Fighter } = {}
local eliminationOrder: { Fighter } = {}
local lastPlacements: { Fighter } = {}

-- Helpers ------------------------------------------------------------------------------

local function setState(name: string, duration: number?, extra: { [string]: any }?)
	gameState:SetAttribute("State", name)
	gameState:SetAttribute("EndsAt", if duration then Workspace:GetServerTimeNow() + duration else 0)
	if extra then
		for key, value in extra do
			gameState:SetAttribute(key, value)
		end
	end
end

local function announce(text: string, style: string, subtitle: string?, target: Player?)
	if target then
		announceRemote:FireClient(target, text, style, subtitle)
	else
		announceRemote:FireAllClients(text, style, subtitle)
	end
end

local function publishScoreboard()
	local rows = {}
	for _, fighter in participants do
		table.insert(rows, {
			Id = fighter.Id,
			Name = fighter.Name,
			Points = fighter.Points,
			KOs = fighter.KOs,
			Alive = fighter.Alive,
			Bot = fighter.IsBot,
			Crown = fighter.Crowned,
		})
	end
	table.sort(rows, function(a, b)
		if a.Points ~= b.Points then
			return a.Points > b.Points
		end
		return a.KOs > b.KOs
	end)
	gameState:SetAttribute("Scoreboard", HttpService:JSONEncode(rows))
end

local function realPlayers(): { Player }
	local list = {}
	for _, player in Players:GetPlayers() do
		if FighterService.GetByPlayer(player) then
			table.insert(list, player)
		end
	end
	return list
end

local function hasRealParticipants(): boolean
	for _, fighter in participants do
		if fighter.Player and fighter.Player.Parent then
			return true
		end
	end
	return false
end

local function anyRealAlive(): boolean
	for _, fighter in participants do
		if fighter.Player and fighter.Alive then
			return true
		end
	end
	return false
end

local function aliveCount(): number
	local count = 0
	for _, fighter in participants do
		if fighter.Alive then
			count += 1
		end
	end
	return count
end

local function sendToLobby(fighter: Fighter)
	fighter.Alive = false
	fighter.Zone = "None"
	FighterService.SetFrozen(fighter, false)
	if fighter.IsBot then
		BotService.DespawnModel(fighter)
	elseif fighter.Player and fighter.Player.Parent then
		local player = fighter.Player
		task.spawn(function()
			local ok, err = pcall(function()
				player:LoadCharacter()
			end)
			if not ok then
				warn("[LaunchParty] LoadCharacter failed:", err)
			end
		end)
	end
end

local function updateCrown()
	local best, bestPoints, tie = nil, 0, false
	for _, fighter in participants do
		if fighter.Points > bestPoints then
			best, bestPoints, tie = fighter, fighter.Points, false
		elseif fighter.Points == bestPoints and bestPoints > 0 then
			tie = true
		end
	end
	for _, fighter in participants do
		fighter.Crowned = (fighter == best and not tie)
		FighterService.RefreshTag(fighter)
	end
end

-- Eliminations -----------------------------------------------------------------------

local function eliminate(fighter: Fighter)
	if not fighter.Alive then
		return
	end
	fighter.Alive = false
	table.insert(eliminationOrder, fighter)
	local position = if fighter.Root then fighter.Root.Position else ArenaService.GetCenter()

	local killer: Fighter? = nil
	local lastHitBy = fighter.LastHitBy
	if lastHitBy and lastHitBy ~= fighter and os.clock() - fighter.LastHitTime <= M.KOCreditWindow then
		if table.find(participants, lastHitBy) then
			killer = lastHitBy
		end
	end
	local bounty = false
	if killer then
		killer.KOs += 1
		killer.Points += M.KOPoints
		if fighter.Crowned then
			killer.Points += M.BountyBonus
			bounty = true
		end
		if killer.Player then
			DataService.AddKO(killer.Player)
		end
	end

	feedRemote:FireAllClients({
		Killer = if killer then killer.Name else nil,
		KillerId = if killer then killer.Id else nil,
		Victim = fighter.Name,
		VictimId = fighter.Id,
		Bounty = bounty,
	})
	effectRemote:FireAllClients("KO", { Position = position, Victim = fighter.Id })
	publishScoreboard()

	task.delay(1.5, function()
		if not fighter.Alive and fighter.Zone == "Arena" then
			sendToLobby(fighter)
		end
	end)
end

local function secondWind(fighter: Fighter)
	fighter.LivesLeft -= 1
	fighter.VoidImmuneUntil = os.clock() + 1.5
	local cframe = ArenaService.GetSafeCFrame()
	FighterService.Teleport(fighter, cframe)
	effectRemote:FireAllClients("SecondWind", { Position = cframe.Position, Fighter = fighter.Id })
	feedRemote:FireAllClients({ Text = string.format("💨 %s used Second Wind!", fighter.Name) })
	if fighter.Player then
		announce("SECOND WIND!", "Small", "The void spat you back out.", fighter.Player)
	end
end

local function checkEliminations()
	local voidY = ArenaService.GetVoidY()
	local now = os.clock()
	for _, fighter in table.clone(participants) do
		if fighter.Alive then
			if not FighterService.IsAlive(fighter) or fighter.Zone ~= "Arena" then
				eliminate(fighter)
			elseif now > fighter.VoidImmuneUntil and (fighter.Root :: BasePart).Position.Y < voidY then
				if fighter.LivesLeft > 0 then
					secondWind(fighter)
				else
					eliminate(fighter)
				end
			end
		end
	end
end

-- Spawning ----------------------------------------------------------------------------

local function spawnFighter(fighter: Fighter, cframe: CFrame): boolean
	if fighter.IsBot then
		if not BotService.SpawnModel(fighter, cframe) then
			return false
		end
	else
		local player = fighter.Player
		if not player or not player.Parent then
			return false
		end
		if not FighterService.IsAlive(fighter) or fighter.Model ~= player.Character then
			local ok = pcall(function()
				player:LoadCharacter()
			end)
			if not ok then
				return false
			end
			local started = os.clock()
			while
				(fighter.Model ~= player.Character or not FighterService.IsAlive(fighter))
				and os.clock() - started < 6
			do
				task.wait(0.05)
			end
			if not FighterService.IsAlive(fighter) then
				return false
			end
		end
		FighterService.Teleport(fighter, cframe)
	end
	fighter.Zone = "Arena"
	fighter.Alive = true
	FighterService.SetHeat(fighter, 0)
	FighterService.ApplyStats(fighter)
	FighterService.SetFrozen(fighter, true)
	return true
end

local function addLateJoiners()
	for _, player in realPlayers() do
		local fighter = FighterService.GetByPlayer(player)
		if fighter and not fighter.InMatch then
			FighterService.ResetForMatch(fighter)
			fighter.InMatch = true
			table.insert(participants, fighter)
			announce("You're in!", "Small", "Joining the match this round.", player)
		end
	end
end

local function setupParticipants()
	table.clear(participants)
	for _, player in realPlayers() do
		local fighter = FighterService.GetByPlayer(player)
		if fighter then
			FighterService.ResetForMatch(fighter)
			fighter.InMatch = true
			table.insert(participants, fighter)
		end
	end
	local botCount = math.clamp(M.MinFighters - #participants, 0, M.MaxBots)
	for _ = 1, botCount do
		local bot = BotService.CreateBot()
		bot.InMatch = true
		table.insert(participants, bot)
	end
end

-- Phases -------------------------------------------------------------------------------

local function waitPhase(seconds: number): boolean
	local ends = os.clock() + seconds
	while os.clock() < ends do
		if #realPlayers() < M.MinRealPlayers then
			return false
		end
		task.wait(0.2)
	end
	return true
end

local function computePlacements(): { Fighter }
	local survivors = {}
	for _, fighter in participants do
		if fighter.Alive then
			table.insert(survivors, fighter)
		end
	end
	-- Time-out ties go to whoever is least cooked.
	table.sort(survivors, function(a, b)
		return a.Heat < b.Heat
	end)
	local placements = survivors
	for i = #eliminationOrder, 1, -1 do
		local fighter = eliminationOrder[i]
		if table.find(participants, fighter) and not table.find(placements, fighter) then
			table.insert(placements, fighter)
		end
	end
	return placements
end

local function runRound(round: number)
	addLateJoiners()
	table.clear(eliminationOrder)

	local shape = if round == 1 then "Disc" else ArenaService.ShapeNames[rng:NextInteger(1, #ArenaService.ShapeNames)]
	ArenaService.Build(shape)
	local event = EventService.Pick(round)
	setState("Countdown", M.CountdownTime + 2, {
		Round = round,
		MaxRounds = M.RoundsPerMatch,
		Event = event.Name,
		EventDesc = event.Description,
		Arena = ArenaService.ShapeTitles[shape] or shape,
		SuddenDeath = false,
	})

	-- Spawn everyone in parallel (LoadCharacter yields).
	local order = table.clone(participants)
	for i = #order, 2, -1 do
		local j = rng:NextInteger(1, i)
		order[i], order[j] = order[j], order[i]
	end
	local spawns = ArenaService.GetSpawnCFrames(#order)
	local pending = #order
	for i, fighter in order do
		FighterService.ResetForRound(fighter)
		task.spawn(function()
			local ok, result = pcall(spawnFighter, fighter, spawns[i])
			if not ok then
				warn("[LaunchParty] Spawn failed:", fighter.Name, result)
			end
			pending -= 1
		end)
	end
	local spawnStarted = os.clock()
	while pending > 0 and os.clock() - spawnStarted < 8 do
		task.wait(0.05)
	end
	publishScoreboard()

	announce(string.format("ROUND %d", round), "Big", event.Name .. " — " .. event.Description)
	task.wait(2)
	for count = M.CountdownTime, 1, -1 do
		announce(tostring(count), "Count")
		task.wait(1)
	end

	for _, fighter in participants do
		if fighter.Alive then
			FighterService.SetFrozen(fighter, false)
		end
	end
	CombatService.SetArenaLive(true)
	EventService.Start(event)
	announce("LAUNCH!", "Big")
	setState("Live", M.RoundTime)

	local started = os.clock()
	local lastCrumble = 0
	local suddenDeath = false
	while true do
		task.wait(0.1)
		checkEliminations()
		if aliveCount() <= 1 or not hasRealParticipants() then
			break
		end
		local elapsed = os.clock() - started
		if elapsed >= M.RoundTime then
			break
		end
		local spectatorsOnly = not anyRealAlive()
		if elapsed >= M.SuddenDeathAt or spectatorsOnly then
			if not suddenDeath then
				suddenDeath = true
				gameState:SetAttribute("SuddenDeath", true)
				announce("SUDDEN DEATH", "Event", "The island is crumbling!")
			end
			local interval = if spectatorsOnly then M.FastCrumbleInterval else M.CrumbleInterval
			if os.clock() - lastCrumble >= interval then
				lastCrumble = os.clock()
				ArenaService.CrumbleStep()
			end
		end
	end

	CombatService.SetArenaLive(false)
	EventService.Stop()

	local placements = computePlacements()
	for index, fighter in placements do
		fighter.Points += M.PlacementPoints[index] or 0
		fighter.Placement = index
	end
	lastPlacements = placements
	updateCrown()
	publishScoreboard()

	local winner = placements[1]
	setState("RoundEnd", M.RoundEndTime)
	if winner then
		announce(winner.Name .. " WINS!", "Big", string.format("Round %d of %d", round, M.RoundsPerMatch))
		effectRemote:FireAllClients("RoundWin", { Fighter = winner.Id })
	end

	task.wait(1.5)
	for _, fighter in participants do
		if fighter.Zone == "Arena" then
			sendToLobby(fighter)
		end
	end
	task.wait(M.RoundEndTime - 1.5)
	ArenaService.Clear()
end

local function runDraft()
	setState("Draft", M.DraftTime)
	announce("DRAFT A PERK", "Big", "Lower placements get luckier cards.")
	local luckBy: { [Fighter]: number } = {}
	local count = #lastPlacements
	for index, fighter in lastPlacements do
		luckBy[fighter] = if count > 1 then (index - 1) / (count - 1) else 0.5
	end
	for _, fighter in participants do
		if luckBy[fighter] == nil then
			luckBy[fighter] = 1 -- late joiners / no-shows get the best odds
		end
	end
	DraftService.Run(participants, luckBy, M.DraftTime)
end

local function finishMatch()
	local ranked = table.clone(participants)
	table.sort(ranked, function(a, b)
		if a.Points ~= b.Points then
			return a.Points > b.Points
		end
		return a.KOs > b.KOs
	end)
	local podium = {}
	for index = 1, math.min(3, #ranked) do
		local fighter = ranked[index]
		table.insert(podium, { Name = fighter.Name, Points = fighter.Points, KOs = fighter.KOs, Bot = fighter.IsBot })
	end
	local champion = ranked[1]
	setState("MatchEnd", M.MatchEndTime, { Champion = if champion then champion.Name else "" })
	if champion then
		announce("👑 " .. champion.Name .. " 👑", "Big", "is the LAUNCH PARTY champion!")
	end

	for index, fighter in ranked do
		local player = fighter.Player
		if player and player.Parent then
			local rewards = DataService.AwardMatch(player, {
				Points = fighter.Points,
				KOs = fighter.KOs,
				Placement = index,
				Won = index == 1,
			})
			resultsRemote:FireClient(player, {
				Podium = podium,
				Placement = index,
				Total = #ranked,
				Points = fighter.Points,
				KOs = fighter.KOs,
				Rewards = rewards,
			})
		end
	end
	task.wait(M.MatchEndTime)
end

local function cleanupMatch()
	CombatService.SetArenaLive(false)
	EventService.Stop()
	for _, fighter in participants do
		if fighter.IsBot then
			BotService.Remove(fighter)
		else
			fighter.InMatch = false
			FighterService.ResetForMatch(fighter)
			if fighter.Zone == "Arena" then
				sendToLobby(fighter)
			end
		end
	end
	table.clear(participants)
	table.clear(eliminationOrder)
	table.clear(lastPlacements)
	ArenaService.Clear()
	publishScoreboard()
end

local function runMatch()
	setState("Waiting", nil, { Round = 0, Event = "", EventDesc = "", SuddenDeath = false })
	while #realPlayers() < M.MinRealPlayers do
		task.wait(1)
	end

	setState("Intermission", M.FirstIntermission, { Round = 0, MaxRounds = M.RoundsPerMatch })
	if not waitPhase(M.FirstIntermission) then
		return
	end

	setupParticipants()
	for round = 1, M.RoundsPerMatch do
		if not hasRealParticipants() then
			break
		end
		runRound(round)
		if round < M.RoundsPerMatch and hasRealParticipants() then
			runDraft()
		end
	end
	if hasRealParticipants() then
		finishMatch()
	end
end

-- Players ------------------------------------------------------------------------------

local function syncProgression(fighter: Fighter)
	local player = fighter.Player
	if not player then
		return
	end
	local level = player:GetAttribute("Level") or 1
	local tier, title = Progression.TitleFor(level)
	fighter.Level = level
	fighter.TrailTier = tier
	fighter.TitleName = title
	FighterService.RefreshCosmetics(fighter)
end

local function onCharacter(fighter: Fighter, character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	local player = fighter.Player
	if not humanoid or not root or not player or player.Character ~= character then
		return
	end
	if fighter.Alive then
		-- Character was replaced mid-round (reset, etc.): that's an elimination, KO credit included.
		eliminate(fighter)
	end
	FighterService.BindModel(fighter, character)
	fighter.Zone = "Lobby"
end

local function onPlayerAdded(player: Player)
	local fighter = FighterService.New("P" .. player.UserId, player.DisplayName, { Player = player })
	player:GetAttributeChangedSignal("Level"):Connect(function()
		syncProgression(fighter)
	end)
	player.CharacterAdded:Connect(function(character)
		onCharacter(fighter, character)
	end)
	if player.Character then
		task.spawn(onCharacter, fighter, player.Character)
	end
	task.spawn(DataService.Load, player)
end

local function onPlayerRemoving(player: Player)
	local fighter = FighterService.GetByPlayer(player)
	if not fighter then
		return
	end
	if fighter.Alive then
		eliminate(fighter)
	end
	local index = table.find(participants, fighter)
	if index then
		table.remove(participants, index)
	end
	FighterService.Remove(fighter)
	publishScoreboard()
end

-- Lobby safety net: anyone who escapes or falls out of the lobby gets respawned.
local function lobbyWatch()
	while true do
		task.wait(0.5)
		local lobbyVoid = ArenaService.GetLobbyVoidY()
		for _, fighter in FighterService.All() do
			if fighter.Player and fighter.Zone == "Lobby" and FighterService.IsAlive(fighter) then
				if (fighter.Root :: BasePart).Position.Y < lobbyVoid then
					FighterService.Teleport(fighter, ArenaService.GetLobbySpawnCFrame())
				end
			end
		end
	end
end

function RoundService.Init()
	Players.RespawnTime = 2
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
	task.spawn(lobbyWatch)
	publishScoreboard()
end

function RoundService.Start()
	task.spawn(function()
		while true do
			local ok, err = pcall(runMatch)
			if not ok then
				warn("[LaunchParty] Match loop error:", err)
			end
			local cleaned, cleanupErr = pcall(cleanupMatch)
			if not cleaned then
				warn("[LaunchParty] Cleanup error:", cleanupErr)
			end
			task.wait(if ok then 1 else 3)
		end
	end)
end

return RoundService
]]></ProtectedString>
					</Properties>
				</Item>
			</Item>
		</Item>
	</Item>
	<Item class="StarterPlayer" referent="RBX00000016">
		<Properties>
			<string name="Name">StarterPlayer</string>
			<float name="CameraMaxZoomDistance">45</float>
		</Properties>
		<Item class="StarterPlayerScripts" referent="RBX00000017">
			<Properties>
				<string name="Name">StarterPlayerScripts</string>
			</Properties>
			<Item class="LocalScript" referent="RBX00000018">
				<Properties>
					<string name="Name">Client</string>
					<ProtectedString name="Source"><![CDATA[-- LAUNCH PARTY client bootstrap.
local Controllers = script:WaitForChild("Controllers")

local ORDER = { "EffectsController", "HUDController", "DraftController", "InputController" }

for _, name in ORDER do
	local ok, controller = pcall(require, Controllers:WaitForChild(name))
	if not ok then
		warn("[LaunchParty] Failed to load", name, controller)
		continue
	end
	local started, err = pcall(controller.Start)
	if not started then
		warn("[LaunchParty] Failed to start", name, err)
	end
end
]]></ProtectedString>
				</Properties>
				<Item class="Folder" referent="RBX00000019">
