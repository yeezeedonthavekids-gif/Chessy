{
  "name": "chessy",
  "private": true,
  "version": "0.1.0",
  "description": "Chessy — a free, local-first AI chess coach for reviewing completed games and training.",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "postinstall": "node scripts/copy-engine.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:puzzles": "node scripts/verify-puzzles.mjs",
    "data:openings": "node scripts/build-openings.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "chess.js": "^1.4.0",
    "idb": "^8.0.0",
    "react": "^18.3.1",
    "react-chessboard": "^4.7.2",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "stockfish": "17.1.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
